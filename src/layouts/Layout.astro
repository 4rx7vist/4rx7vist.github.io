---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import Preloader from '../components/Preloader.astro';
import Text from '../components/Text.astro';
import { sitePath } from '../utils/paths';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const {
  title = 'ALEXIS_DEV — Software Engineer · Alexis Sotomayor',
  description = 'Software, infrastructure, and systems. Explore the engineering work of Alexis Sotomayor: backend architecture, integrations, automation, and cloud.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('preferred-theme');
        document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light'
          ? savedTheme
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ALEXIS_DEV" />
    <link rel="icon" type="image/png" href={sitePath('portfolio_logo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nata+Sans:wght@400;500;550;600;650;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      try { document.documentElement.lang = localStorage.getItem('preferred-lang') === 'es' ? 'es' : 'en'; } catch {}
    </script>
  </head>
  <body>
    <Preloader />
    <a class="skip-link" href="#main"><Text en="Skip to content" es="Ir al contenido" /></a>
    <Navbar />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import Lenis from 'lenis';

      const smoothScrollContext = window.matchMedia('(min-width: 801px) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
      let lenis: Lenis | undefined;
      let animationFrame = 0;

      const updateProgress = (progress = 0) => {
        document.documentElement.style.setProperty('--scroll-progress', String(progress));
      };

      const stopSmoothScroll = () => {
        cancelAnimationFrame(animationFrame);
        lenis?.destroy();
        lenis = undefined;
        updateProgress(window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight));
      };

      const startSmoothScroll = () => {
        stopSmoothScroll();
        if (!smoothScrollContext.matches) return;

        lenis = new Lenis({
          duration: 1.05,
          easing: (time) => Math.min(1, 1.001 - Math.pow(2, -10 * time)),
          smoothWheel: true,
          anchors: true,
        });

        lenis.on('scroll', (instance) => updateProgress(instance.progress));
        const raf = (time: number) => {
          lenis?.raf(time);
          animationFrame = requestAnimationFrame(raf);
        };
        animationFrame = requestAnimationFrame(raf);
      };

      startSmoothScroll();
      smoothScrollContext.addEventListener('change', startSmoothScroll);
      window.addEventListener('scroll', () => {
        if (lenis) return;
        updateProgress(window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight));
      }, { passive: true });
      window.addEventListener('resize', () => {
        updateProgress(window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight));
      }, { passive: true });

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const revealElements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      if (!reducedMotion.matches && 'IntersectionObserver' in window && revealElements.length) {
        document.documentElement.classList.add('motion-ready');
        const compactMotion = window.matchMedia('(max-width: 800px), (pointer: coarse)').matches;
        const revealObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const element = entry.target as HTMLElement;
            element.classList.add('is-revealed');
            revealObserver.unobserve(element);
            window.setTimeout(() => element.classList.add('reveal-complete'), compactMotion ? 560 : 950);
          });
        }, {
          threshold: compactMotion ? .08 : .14,
          rootMargin: compactMotion ? '0px 0px -6% 0px' : '0px 0px -12% 0px',
        });

        revealElements.forEach(element => revealObserver.observe(element));
      }
    </script>
  </body>
</html>
