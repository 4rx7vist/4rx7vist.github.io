---
// Preloader.astro
---

<div id="preloader" class="fixed inset-0 z-[100000] flex items-center justify-center bg-[#030712] text-white">
  <div class="text-4xl md:text-7xl font-bold tracking-widest font-mono flex" id="scramble-container">
    <!-- Letters will be injected here -->
  </div>
</div>

<script>
  import { gsap } from "gsap";

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('scramble-container');
    const preloader = document.getElementById('preloader');
    
    if (!container || !preloader) return;

    const finalWord = "4rx7vist";
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*";
    
    // Create spans for each character
    const charElements = finalWord.split('').map((char) => {
      const span = document.createElement('span');
      // Adding initial blur and making it occupy space
      span.className = 'inline-block min-w-[1ch] text-center blur-[4px] transition-all duration-300';
      span.textContent = chars[Math.floor(Math.random() * chars.length)];
      container.appendChild(span);
      return span;
    });

    let iterations = 0;
    const maxIterations = 15; // Base iterations before letters start settling

    const interval = setInterval(() => {
      charElements.forEach((span, index) => {
        // Stagger the stopping of each letter from RIGHT to LEFT
        const reversedIndex = charElements.length - 1 - index;
        const letterMax = maxIterations + (reversedIndex * 6);
        
        if (iterations >= letterMax) {
           span.textContent = finalWord[index];
           span.classList.remove('blur-[4px]');
           span.classList.add('text-[#3b82f6]', 'blur-none'); // Highlight and clear when settled
        } else {
           span.textContent = chars[Math.floor(Math.random() * chars.length)];
           span.classList.remove('text-[#3b82f6]', 'blur-none');
           span.classList.add('blur-[4px]');
        }
      });

      // Total iterations until the first letter (index 0, reversedIndex 7) is done
      if (iterations >= maxIterations + ((charElements.length - 1) * 6)) {
        clearInterval(interval);
        
        // Wipe out preloader from RIGHT to LEFT after words are clear
        gsap.to(preloader, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)", // Wipes to the left
          duration: 1.2,
          delay: 0.6,
          ease: "power3.inOut",
          onStart: () => {
             // ensure it starts fully visible as a polygon before wiping
             gsap.set(preloader, { clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)" });
          },
          onComplete: () => {
            preloader.style.display = 'none';
          }
        });
      }
      iterations++;
    }, 50); // Speed of the scramble
  });
</script>
