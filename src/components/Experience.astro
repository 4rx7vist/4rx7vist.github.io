---
import Text from './Text.astro';

const responsibilities = [
  {
    en: 'Design, build, and maintain backend services and APIs with clear boundaries and dependable integrations.',
    es: 'Diseñar, construir y mantener servicios backend y APIs con límites claros e integraciones confiables.',
  },
  {
    en: 'Automate CI/CD pipelines and release workflows across development, staging, and production environments.',
    es: 'Automatizar pipelines de CI/CD y procesos de despliegue entre entornos de desarrollo, staging y producción.',
  },
  {
    en: 'Operate cloud infrastructure, containers, secrets, monitoring, logs, and alerts for production systems.',
    es: 'Operar infraestructura cloud, contenedores, secretos, monitoreo, logs y alertas para sistemas en producción.',
  },
  {
    en: 'Improve database performance, service reliability, incident response, and technical documentation.',
    es: 'Mejorar el rendimiento de bases de datos, la confiabilidad de servicios, la respuesta a incidentes y la documentación técnica.',
  },
];
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="experience-inner page-width">
    <header class="experience-heading" data-reveal="heading">
      <p class="section-label"><Text en="EXPERIENCE" es="EXPERIENCIA" /></p>
      <div>
        <h2 id="experience-title"><Text en="Building what keeps products running." es="Construyendo lo que mantiene los productos funcionando." /></h2>
        <p><Text en="Backend engineering and cloud operations, approached as one connected system." es="Ingeniería backend y operaciones cloud, abordadas como un solo sistema conectado." /></p>
      </div>
    </header>

    <article class="role">
      <div class="role-meta" data-reveal="copy">
        <p class="role-type"><Text en="CURRENT FOCUS" es="ENFOQUE ACTUAL" /></p>
        <h3>Backend Engineering<br />/ DevOps</h3>
        <p class="company"><Text en="Startup Tech Company" es="Startup tecnológica" /></p>
      </div>

      <div class="role-details" data-reveal="list">
        <h4><Text en="Key responsibilities" es="Responsabilidades principales" /></h4>
        <ul>
          {responsibilities.map((responsibility) => (
            <li><span aria-hidden="true">↳</span><p><Text {...responsibility} /></p></li>
          ))}
        </ul>
      </div>
    </article>

    <div class="certificate-row" data-reveal="copy">
      <div>
        <p class="section-label"><Text en="CERTIFICATE" es="CERTIFICADO" /></p>
        <p class="certificate-note"><Text en="Cloud architecture" es="Arquitectura cloud" /></p>
      </div>
      <div class="certificate-name">
        <span class="aws-mark" aria-hidden="true">AWS / SAA</span>
        <h3>AWS Certified Solutions Architect – Associate</h3>
      </div>
    </div>
  </div>
</section>

<style>
  .experience { border-top: 1px solid var(--line); }
  .experience-inner { padding-block: var(--space-section); }
  .experience-heading { display: grid; grid-template-columns: .62fr 1.38fr; gap: clamp(48px, 8vw, 120px); align-items: start; margin-bottom: 78px; }
  .experience-heading h2 { max-width: 13ch; font-size: clamp(3rem, 5.1vw, 5rem); line-height: 1.04; font-weight: 550; letter-spacing: -.04em; }
  .experience-heading > div > p { max-width: 54ch; margin-top: 26px; color: var(--muted); font-size: .9375rem; }
  .role { display: grid; grid-template-columns: .62fr 1.38fr; gap: clamp(48px, 8vw, 120px); padding-top: 28px; border-top: 1px solid var(--ink); }
  .role-type { color: var(--blue); font-size: .6875rem; letter-spacing: .06em; }
  .role-meta h3 { margin-top: 18px; font-size: clamp(2rem, 3.7vw, 3.3rem); font-weight: 550; line-height: 1.12; letter-spacing: -.035em; }
  .company { margin-top: 18px; color: var(--muted); font-size: .875rem; }
  .role-details h4 { margin: 0 0 22px; font-size: 1.125rem; font-weight: 550; }
  .role-details ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .role-details li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; padding-block: 18px; border-bottom: 1px solid var(--line); }
  .role-details li > span { color: var(--blue); font-size: .8125rem; padding-top: 2px; }
  .role-details li p { max-width: 68ch; font-size: .8125rem; color: var(--muted); }
  .certificate-row { display: grid; grid-template-columns: .62fr 1.38fr; gap: clamp(48px, 8vw, 120px); margin-top: 76px; padding-top: 28px; border-top: 1px solid var(--line); }
  .certificate-note { margin-top: 10px; color: var(--muted); font-size: .6875rem; }
  .certificate-name { display: flex; align-items: baseline; justify-content: space-between; gap: 32px; }
  .certificate-name h3 { max-width: 24ch; font-size: 1.125rem; font-weight: 550; line-height: 1.45; }
  .aws-mark { order: 2; flex: 0 0 auto; color: var(--blue); font-size: .6875rem; letter-spacing: .06em; }

  @media(max-width: 800px) {
    .experience-heading, .role, .certificate-row { grid-template-columns: 1fr; gap: 34px; }
    .experience-heading { margin-bottom: 56px; }
    .experience-heading h2 { max-width: 12ch; }
    .role-details h4 { margin-top: 10px; }
    .certificate-row { margin-top: 56px; }
  }
  @media(max-width: 520px) {
    .certificate-name { align-items: flex-start; flex-direction: column; gap: 14px; }
    .aws-mark { order: initial; }
  }
</style>
