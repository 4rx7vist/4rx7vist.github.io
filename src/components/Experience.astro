---
const experiences = [
  {
    company: "Digital Solutions Ltd.",
    position: "Frontend Developer",
    period: "2019 - 2021",
    description: "Developed responsive web applications for enterprise clients using Vue.js and Nuxt.js. Worked closely with designers to implement pixel-perfect UI components.",
    achievements: [
      "Built an e-commerce platform serving over 10,000 daily active users",
      "Implemented comprehensive unit and integration testing, achieving 90% code coverage",
      "Optimized rendering performance for complex data visualizations"
    ]
  },
];

const volunteering = [
  {
    organization: "Banco De Alimentos Quito. BAQ",
    role: "Backend Developer",
    period: "2024 - Present",
    description: "Design a microservice to support their mobile application, focusing on the efficient development and management of a RESTful API.",
    achievements: [
      "Implemented optimized input routes and integrated PostgreSQL to ensure structured, reliable data storage.",
      "Created comprehensive technical documentation to support the API's usability and long-term maintenance.",
      "Configured and managed separate development, testing, and production environments to ensure smooth deployment and scalability of the service."
    ]
  },
  {
    organization: "Local Community Center",
    role: "IT Support Volunteer",
    period: "2018 - 2020",
    description: "Provided technical support and training to community members on basic computer skills and internet usage.",
    achievements: []
  }
];

const timelineItems = [
  ...experiences.map(exp => ({ ...exp, type: 'professional' })),
  ...volunteering.map(vol => ({ ...vol, type: 'volunteering' }))
].sort((a, b) => {
  const yearA = parseInt(a.period.split(' - ')[0]);
  const yearB = parseInt(b.period.split(' - ')[0]);
  return yearB - yearA;
});

// Normalizar campos para evitar checks de tipo en el template
const normalizedTimelineItems = timelineItems.map(item => ({
  ...item,
  title: item.position ?? item.role ?? item.organization ?? item.company ?? '',
  subtitle: item.company ?? item.organization ?? ''
}));
---
<section class="bg-black py-20 px-4 relative overflow-hidden">
  <!-- fondo decorativo eliminado -->

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4" id="exp-title">Experience</h2>
      <p class="text-gray-400 text-lg" id="exp-subtitle">Professional Journey & Contributions</p>
    </div>

    <div class="relative">
      <!-- Línea vertical rainbow animable -->
      <div
        id="timeline-line"
        class="absolute left-6 md:left-1/2 transform md:-translate-x-1/2 w-1.5 rounded-lg opacity-90"
        style="height: 0; background: linear-gradient(180deg, #ff4d4d 0%, #ff9a4d 20%, #ffd24d 40%, #6eff6e 60%, #4dd7ff 80%, #9b63ff 100%); background-size: 100% 200%;"
      ></div>

      <div class="space-y-12 md:space-y-16">
        {normalizedTimelineItems.map((item, index) => (
          <div
            class={`timeline-item relative flex flex-col md:flex-row items-start md:items-center gap-8 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}
            data-index={index}
          >
            <!-- Flecha (reemplaza dot) -->
            <div
              class={`timeline-dot absolute left-6 md:left-1/2 transform md:-translate-x-1/2 z-10 flex items-center justify-center pointer-events-auto`}
              data-side={index % 2 === 0 ? 'left' : 'right'}
            >
              <div class="timeline-arrow w-10 h-10 flex items-center justify-center rounded-md bg-[#262626] border-4 border-black shadow-lg">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M6 12h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <!-- Contenido del item -->
            <div class={`timeline-content flex-1 ml-16 md:ml-0 ${index % 2 === 0 ? 'md:text-right md:pr-8' : 'md:pl-8'}`}>
              <div class="text-sm text-gray-400">{item.period}</div>
              <h3 class="text-lg md:text-2xl font-semibold text-white mt-1">{item.title}</h3>
              <div class="text-base text-gray-300">{item.subtitle}</div>
              <p class="text-gray-400 mt-2">{item.description}</p>

              {item.achievements && item.achievements.length > 0 ? (
                <ul class="mt-3 list-disc list-inside text-gray-400 space-y-1">
                  {item.achievements.map((ach) => <li>{ach}</li>)}
                </ul>
              ) : null}
            </div>

            <!-- Spacer para balance en desktop -->
            <div class="hidden md:block flex-1"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-dot { width: 44px; height: 44px; pointer-events: auto; }
  .timeline-dot[data-side="right"] .timeline-arrow svg {
    transform: rotate(180deg);
  }

  .timeline-arrow {
    transition: transform .25s ease, box-shadow .25s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-arrow:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 8px 30px rgba(0,0,0,0.6);
  }

  /* Ajustes responsivos para que la línea no tape contenido en mobile */
  @media (max-width: 767px) {
    #timeline-line { left: 1rem !important; transform: none !important; }
    .timeline-dot { left: 1rem !important; transform: none !important; }
    .timeline-content { margin-left: 4.5rem !important; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initExperienceAnimations() {
    // Título
    const titleTl = gsap.timeline({
      scrollTrigger: {
        trigger: "#exp-title",
        start: "top 80%",
        end: "bottom 60%",
        toggleActions: "play none none reverse"
      }
    });

    titleTl
      .from("#exp-title", { duration: 1, y: 50, opacity: 0, ease: "power2.out" })
      .from("#exp-subtitle", { duration: 0.8, y: 30, opacity: 0, ease: "power2.out" }, "-=0.5");

  // fondo decorativo eliminado (no hay elemento #experience-bg-text)

    // Línea rainbow: altura y desplazamiento del degradado
    const line = document.getElementById("timeline-line");
    if (line) {
      gsap.to(line, {
        height: "100%",
        ease: "none",
        scrollTrigger: {
          trigger: line,
          start: "top 80%",
          end: "bottom 20%",
          scrub: 1
        }
      });

      gsap.to(line, {
        backgroundPositionY: "200%",
        ease: "none",
        scrollTrigger: {
          trigger: line,
          start: "top 80%",
          end: "bottom 20%",
          scrub: 1
        }
      });
    }

    // Animación por item
    const items = gsap.utils.toArray(".timeline-item");
    items.forEach((item, index) => {
      const content = item.querySelector(".timeline-content");
      const dot = item.querySelector(".timeline-dot");
      const isEven = index % 2 === 0;

      const itemTl = gsap.timeline({
        scrollTrigger: {
          trigger: item,
          start: "top 85%",
          end: "bottom 60%",
          toggleActions: "play none none reverse"
        }
      });

      itemTl.from(dot, { duration: 0.6, scale: 0, opacity: 0, ease: "back.out(1.7)" });

      itemTl.from(content, {
        duration: 0.8,
        x: isEven && window.innerWidth >= 768 ? 50 : -50,
        opacity: 0,
        ease: "power2.out"
      }, "-=0.3");

      const achievements = content.querySelectorAll("li");
      if (achievements.length > 0) {
        itemTl.from(achievements, {
          duration: 0.5,
          x: isEven && window.innerWidth >= 768 ? 30 : -30,
          opacity: 0,
          stagger: 0.1,
          ease: "power2.out"
        }, "-=0.4");
      }
    });

    // Hover effects
    items.forEach((item) => {
      const content = item.querySelector(".timeline-content");
      const dot = item.querySelector(".timeline-dot");

      item.addEventListener("mouseenter", () => {
        gsap.to(dot, { duration: 0.25, scale: 1.12, ease: "power2.out" });
        gsap.to(content, { duration: 0.25, y: -6, ease: "power2.out" });
      });

      item.addEventListener("mouseleave", () => {
        gsap.to(dot, { duration: 0.25, scale: 1, ease: "power2.out" });
        gsap.to(content, { duration: 0.25, y: 0, ease: "power2.out" });
      });
    });
  }

  if (document.readyState === "loading") {
    window.addEventListener("DOMContentLoaded", initExperienceAnimations);
  } else {
    initExperienceAnimations();
  }

  let resizeTimeout;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      ScrollTrigger.refresh();
    }, 250);
  });
</script>