---
const experiences = [
  {
    company: "Digital Solutions Ltd.",
    position: "Frontend Developer",
    period: "2019 - 2021",
    description: "Developed responsive web applications for enterprise clients using Vue.js and Nuxt.js. Worked closely with designers to implement pixel-perfect UI components.",
    achievements: [
      "Built an e-commerce platform serving over 10,000 daily active users",
      "Implemented comprehensive unit and integration testing, achieving 90% code coverage",
      "Optimized rendering performance for complex data visualizations"
    ]
  },
];

const volunteering = [
  {
    organization: "Banco De Alimentos Quito. BAQ",
    role: "Backend Developer",
    period: "2024 - Present",
    description: "Design a microservice to support their mobile application, focusing on the efficient development and management of a RESTful API. ",
    achievements: [
      "Implemented optimized input routes and integrated PostgreSQL to ensure structured, reliable data storage.",
      "Created comprehensive technical documentation to support the API's usability and long-term maintenance.",
      "Configured and managed separate development, testing, and production environments to ensure smooth deployment and scalability of the service."
    ]
  },
  {
    organization: "Local Community Center",
    role: "IT Support Volunteer",
    period: "2018 - 2020",
    description: "Provided technical support and training to community members on basic computer skills and internet usage.",
    achievements: []
  }
];

// Combinar ambos arrays para el timeline
const timelineItems = [
  ...experiences.map(exp => ({ ...exp, type: 'professional' })),
  ...volunteering.map(vol => ({ ...vol, type: 'volunteering' }))
].sort((a, b) => {
  // Ordenar por año (extraer el año del período)
  const yearA = parseInt(a.period.split(' - ')[0]);
  const yearB = parseInt(b.period.split(' - ')[0]);
  return yearB - yearA; // Más reciente primero
});
---

<section class="bg-black py-20 px-4 relative overflow-hidden">
  <!-- Texto de fondo grande similar al banner -->
  <div class="absolute inset-0 flex items-center justify-center select-none pointer-events-none">
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Título de sección -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4" id="exp-title">
        Experience
      </h2>
      <p class="text-gray-400 text-lg" id="exp-subtitle">
        Professional Journey & Contributions
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative">
      <!-- Línea vertical principal -->
      <div 
        id="timeline-line" 
        class="absolute left-6 md:left-1/2 transform md:-translate-x-1/2 w-0.5 bg-gradient-to-b from-blue-500 via-purple-500 to-pink-500 opacity-60"
        style="height: 0;"
      ></div>

      <!-- Timeline Items -->
      <div class="space-y-12 md:space-y-16">
        {timelineItems.map((item, index) => (
          <div 
            class={`timeline-item relative flex flex-col md:flex-row items-start md:items-center gap-8 ${
              index % 2 === 0 ? 'md:flex-row-reverse' : ''
            }`}
            data-index={index}
          >
            <!-- Timeline Dot -->
            <div class="timeline-dot absolute left-6 md:left-1/2 transform md:-translate-x-1/2 w-4 h-4 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full shadow-lg border-4 border-[#262626] z-10"></div>

            <!-- Contenido -->
            <div class={`timeline-content flex-1 ml-16 md:ml-0 ${
              index % 2 === 0 ? 'md:text-right md:pr-8' : 'md:pl-8'
            }`}>
              
              <!-- Badge de tipo -->
              <div class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold mb-3 ${
                item.type === 'professional' 
                  ? 'bg-blue-500/20 text-blue-400 border border-blue-500/30'
                  : 'bg-green-500/20 text-green-400 border border-green-500/30'
              }`}>
                {item.type === 'professional' ? '💼 Professional' : '🤝 Volunteering'}
              </div>

              <!-- Company/Organization -->
              <h3 class="text-xl md:text-2xl font-bold text-white mb-1">
                {item.company || item.organization}
              </h3>

              <!-- Position/Role -->
              <h4 class="text-lg text-blue-400 font-semibold mb-2">
                {item.position || item.role}
              </h4>

              <!-- Period -->
              <div class="text-gray-400 text-sm mb-4 font-mono">
                {item.period}
              </div>

              <!-- Description -->
              <p class="text-gray-300 text-base mb-4 leading-relaxed">
                {item.description}
              </p>

              <!-- Achievements -->
              {item.achievements && item.achievements.length > 0 && (
                <ul class="space-y-2">
                  {item.achievements.map((achievement) => (
                    <li class="text-gray-400 text-sm flex items-start gap-2">
                      <span class="text-purple-400 mt-1">▸</span>
                      <span>{achievement}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <!-- Spacer invisible para balance en desktop -->
            <div class="hidden md:block flex-1"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initExperienceAnimations() {
    // Animación inicial del título
    const titleTl = gsap.timeline({
      scrollTrigger: {
        trigger: "#exp-title",
        start: "top 80%",
        end: "bottom 60%",
        toggleActions: "play none none reverse"
      }
    });

    titleTl
      .from("#exp-title", {
        duration: 1,
        y: 50,
        opacity: 0,
        ease: "power2.out"
      })
      .from("#exp-subtitle", {
        duration: 0.8,
        y: 30,
        opacity: 0,
        ease: "power2.out"
      }, "-=0.5");

    // Animación del texto de fondo (similar al banner)
    gsap.to("#experience-bg-text", {
      rotation: 45,
      scale: 1.1,
      ease: "none",
      scrollTrigger: {
        trigger: "#experience-bg-text",
        start: "top bottom",
        end: "bottom top",
        scrub: 1
      }
    });

    // Animación de la línea del timeline
    gsap.to("#timeline-line", {
      height: "100%",
      ease: "none",
      scrollTrigger: {
        trigger: "#timeline-line",
        start: "top 80%",
        end: "bottom 20%",
        scrub: 1
      }
    });

    // Animación de cada item del timeline
    const timelineItems = gsap.utils.toArray(".timeline-item");
    
    timelineItems.forEach((item, index) => {
      const content = item.querySelector(".timeline-content");
      const dot = item.querySelector(".timeline-dot");
      const isEven = index % 2 === 0;

      const itemTl = gsap.timeline({
        scrollTrigger: {
          trigger: item,
          start: "top 85%",
          end: "bottom 60%",
          toggleActions: "play none none reverse"
        }
      });

      // Animación del dot
      itemTl.from(dot, {
        duration: 0.6,
        scale: 0,
        opacity: 0,
        ease: "back.out(1.7)"
      });

      // Animación del contenido
      itemTl.from(content, {
        duration: 0.8,
        x: isEven && window.innerWidth >= 768 ? 50 : -50,
        opacity: 0,
        ease: "power2.out"
      }, "-=0.3");

      // Animación de los achievements
      const achievements = content.querySelectorAll("li");
      if (achievements.length > 0) {
        itemTl.from(achievements, {
          duration: 0.5,
          x: isEven && window.innerWidth >= 768 ? 30 : -30,
          opacity: 0,
          stagger: 0.1,
          ease: "power2.out"
        }, "-=0.4");
      }
    });

    // Efecto de hover en los items
    timelineItems.forEach((item) => {
      const content = item.querySelector(".timeline-content");
      const dot = item.querySelector(".timeline-dot");

      item.addEventListener("mouseenter", () => {
        gsap.to(dot, {
          duration: 0.3,
          scale: 1.2,
          ease: "power2.out"
        });
        gsap.to(content, {
          duration: 0.3,
          y: -5,
          ease: "power2.out"
        });
      });

      item.addEventListener("mouseleave", () => {
        gsap.to(dot, {
          duration: 0.3,
          scale: 1,
          ease: "power2.out"
        });
        gsap.to(content, {
          duration: 0.3,
          y: 0,
          ease: "power2.out"
        });
      });
    });
  }

  // Ejecutar cuando el DOM esté listo
  if (document.readyState === "loading") {
    window.addEventListener("DOMContentLoaded", initExperienceAnimations);
  } else {
    initExperienceAnimations();
  }

  // Reajustar en resize
  let resizeTimeout;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      ScrollTrigger.refresh();
    }, 250);
  });
</script>