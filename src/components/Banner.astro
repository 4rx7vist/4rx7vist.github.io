---

<section
  class="bg-black min-h-screen flex items-center justify-center relative overflow-hidden px-4"
>
  <!-- Texto de fondo grande -->
  <div
    class="absolute inset-0 flex items-center justify-center px-2 sm:px-8 select-none pointer-events-none"
  >
    <div class="flex w-full max-w-5xl mx-auto justify-center">
      <div
        id="back-text"
        class="text-gray-600 font-black text-[4.5rem] sm:text-[6rem] md:text-[9rem] lg:text-[12rem] xl:text-[15rem] leading-none opacity-20 sm:opacity-30 -translate-x-4 sm:-translate-x-8 md:-translate-x-12 pointer-events-auto"
      >
        PORT
      </div>
      <div
        id="end-text"
        class="text-gray-600 font-black text-[4.5rem] sm:text-[6rem] md:text-[9rem] lg:text-[12rem] xl:text-[15rem] leading-none opacity-20 sm:opacity-30 translate-x-4 sm:translate-x-8 md:translate-x-12 pointer-events-auto"
      >
        VAULT
      </div>
    </div>
  </div>

  <!-- Contenido principal -->
  <div class="relative z-10 text-center max-w-4xl mx-auto px-4">
    <h1
      id="titulo"
      class="text-white text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-extrabold mb-6 leading-tight tracking-tight"
    >
      We Build Software That Scales
    </h1>
    <p 
      id="subtitulo"
      class="text-gray-300 text-base sm:text-lg md:text-xl lg:text-2xl mb-8 max-w-2xl mx-auto font-light leading-relaxed"
    >
      Custom software engineering, payment gateways, and automated workflows designed to drive business growth.
    </p>
    
    <!-- Botones CTA -->
    <div id="cta-buttons" class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-8">
      <a
        href="#projects"
        class="w-full sm:w-auto bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold py-4 px-8 rounded-2xl shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40 hover:scale-105 active:scale-95 transition-all duration-300 text-center"
      >
        Explore Solutions
      </a>
      <a
        href="#contact"
        class="w-full sm:w-auto bg-transparent border-2 border-white/20 hover:border-white/50 text-white font-bold py-4 px-8 rounded-2xl hover:bg-white/5 hover:scale-105 active:scale-95 transition-all duration-300 text-center"
      >
        Build Your Solution
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Registrar el plugin ScrollTrigger
  gsap.registerPlugin(ScrollTrigger);


  // Función para convertir texto en spans individuales y aplicar efecto hover
  function wrapLetters(elementId) {
    const element = document.getElementById(elementId);
    if (!element) return;

    const text = element.innerText;
    element.innerHTML = "";

    for (let i = 0; i < text.length; i++) {
      const span = document.createElement("span");
      span.className = "letter";
      span.innerText = text[i];
      element.appendChild(span);

      // Añadir efecto hover con GSAP
      span.addEventListener("mouseenter", () => {
        gsap.to(span, {
          color: "#ffffff",
          textShadow:
            "0 0 10px rgba(255,255,255,0.8), 0 0 20px rgba(255,255,255,0.5), 0 0 30px rgba(255,255,255,0.3)",
          duration: 0.3,
          ease: "power2.out",
        });
      });

      span.addEventListener("mouseleave", () => {
        gsap.to(span, {
          color: "",
          textShadow: "none",
          duration: 0.3,
          ease: "power2.out",
          clearProps: "color,textShadow", // Importante para restaurar al color original
        });
      });
    }
  }

  // Función para calcular el desplazamiento responsive
  function getResponsiveOffset() {
    const windowWidth = window.innerWidth;

    if (windowWidth < 480) {
      return windowWidth * 0.3;
    } else if (windowWidth < 768) {
      return windowWidth * 0.25;
    } else if (windowWidth < 1024) {
      return windowWidth * 0.2;
    } else {
      return 300;
    }
  }

  // Función para calcular separación del texto de fondo
  function getBackgroundSeparation() {
    const windowWidth = window.innerWidth;

    if (windowWidth < 480) {
      return windowWidth * 0.4; // 40% en móvil
    } else if (windowWidth < 768) {
      return windowWidth * 0.5; // 50% en tablet
    } else {
      return 600; // Valor fijo para desktop
    }
  }

  // Función para inicializar las animaciones
  function initAnimations() {
    const offset = getResponsiveOffset();
    const separation = getBackgroundSeparation();

    // Aplicar efecto de letras individuales
    wrapLetters("back-text");
    wrapLetters("end-text");
    wrapLetters("dev-text");

    // Animación inicial del título, subtítulo y botones CTA
    let tl = gsap.timeline();

    tl.set("#titulo", {
      autoAlpha: 0,
      x: -offset,
    })
    .set("#subtitulo", {
      autoAlpha: 0,
      y: 30,
    })
    .set("#cta-buttons", {
      autoAlpha: 0,
      y: 30,
    })
    .to("#titulo", {
      duration: 1.2,
      autoAlpha: 1,
      x: 0,
      ease: "power3.out",
    })
    .to("#subtitulo", {
      duration: 1.0,
      autoAlpha: 1,
      y: 0,
      ease: "power3.out",
    }, "-=0.6")
    .to("#cta-buttons", {
      duration: 1.0,
      autoAlpha: 1,
      y: 0,
      ease: "back.out(1.7)",
    }, "-=0.6");

    // Animación de separación del texto de fondo al hacer scroll
    gsap.to("#back-text", {
      x: -separation,
      duration: 1,
      ease: "none",
      scrollTrigger: {
        trigger: "section",
        start: "top top",
        end: "bottom top",
        scrub: 1,
        pin: false,
      },
    });

    gsap.to("#end-text", {
      x: separation,
      duration: 1,
      ease: "none",
      scrollTrigger: {
        trigger: "section",
        start: "top top",
        end: "bottom top",
        scrub: 1,
        pin: false,
      },
    });

  }

  // Ejecutar animaciones al cargar
  window.addEventListener("DOMContentLoaded", initAnimations);

  // Reajustar animaciones al cambiar tamaño de pantalla
  let resizeTimeout;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      // Limpiar animaciones anteriores
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
      gsap.set("#titulo, #subtitulo, #cta-buttons, #back-text, #end-text", {
        clearProps: "all",
      });

      // Reiniciar animaciones con nuevos valores
      initAnimations();
    }, 250);
  });
</script>
