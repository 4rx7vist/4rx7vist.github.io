---

---

<section
  class="bg-black min-h-screen flex items-center justify-center relative overflow-hidden px-4"
>
  <!-- Texto de fondo grande -->
  <div
    class="absolute inset-0 flex items-center justify-between px-2 sm:px-8 select-none pointer-events-none"
  >
    <div
      id="back-text"
      class="text-gray-600 font-black text-[6rem] sm:text-[8rem] md:text-[12rem] lg:text-[16rem] xl:text-[20rem] leading-none opacity-20 sm:opacity-30 -translate-x-8 sm:-translate-x-12 md:-translate-x-16"
    >
      BACK
    </div>
    <div
      id="end-text"
      class="text-gray-600 font-black text-[6rem] sm:text-[8rem] md:text-[12rem] lg:text-[16rem] xl:text-[20rem] leading-none opacity-20 sm:opacity-30"
    >
      END
    </div>
  </div>

  <!-- Contenido principal -->
  <div class="relative z-10 text-center max-w-4xl mx-auto">
    <h1
      id="titulo"
      class="text-white text-2xl sm:text-3xl md:text-4xl lg:text-6xl font-bold mb-4"
    >
      I'm Alexis Sotomayor
    </h1>
    <p class="text-gray-300 text-base sm:text-lg md:text-xl mb-2">
      Full Stack Developer | AI Enthusiast
    </p>
    <p class="text-gray-400 text-sm sm:text-base">
      Python • React • AWS • AI/ML
    </p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Registrar el plugin ScrollTrigger
  gsap.registerPlugin(ScrollTrigger);

  console.log("GSAP loaded:", gsap.version);

  // Función para calcular el desplazamiento responsive
  function getResponsiveOffset() {
    const windowWidth = window.innerWidth;

    if (windowWidth < 480) {
      return windowWidth * 0.3;
    } else if (windowWidth < 768) {
      return windowWidth * 0.25;
    } else if (windowWidth < 1024) {
      return windowWidth * 0.2;
    } else {
      return 300;
    }
  }

  // Función para calcular separación del texto de fondo
  function getBackgroundSeparation() {
    const windowWidth = window.innerWidth;

    if (windowWidth < 480) {
      return windowWidth * 0.4; // 40% en móvil
    } else if (windowWidth < 768) {
      return windowWidth * 0.5; // 50% en tablet
    } else {
      return 600; // Valor fijo para desktop
    }
  }

  // Función para inicializar las animaciones
  function initAnimations() {
    const offset = getResponsiveOffset();
    const separation = getBackgroundSeparation();

    // Animación inicial del título
    let tl = gsap.timeline();

    tl.set("#titulo", {
      autoAlpha: 0,
      x: -offset,
    }).to("#titulo", {
      duration: 1.2,
      autoAlpha: 1,
      x: 0,
      ease: "power2.out",
    });

    // Animación de separación del texto de fondo al hacer scroll
    gsap.to("#back-text", {
      x: -separation,
      duration: 1,
      ease: "none",
      scrollTrigger: {
        trigger: "section", // El elemento que activa la animación
        start: "top top",
        end: "bottom top",
        scrub: 1, // Vincula la animación al progreso del scroll
        pin: false,
      },
    });

    gsap.to("#end-text", {
      x: separation,
      duration: 1,
      ease: "none",
      scrollTrigger: {
        trigger: "section",
        start: "top top",
        end: "bottom top",
        scrub: 1,
        pin: false,
      },
    });
  }

  // Ejecutar animaciones al cargar
  window.addEventListener("DOMContentLoaded", initAnimations);

  // Reajustar animaciones al cambiar tamaño de pantalla
  let resizeTimeout;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      // Limpiar animaciones anteriores
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
      gsap.set("#titulo, #back-text, #end-text", { clearProps: "all" });

      // Reiniciar animaciones con nuevos valores
      initAnimations();
    }, 250);
  });
</script>
