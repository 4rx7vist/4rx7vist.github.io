---

---

<section
  class="bg-black min-h-screen flex items-center justify-center relative overflow-hidden px-4"
>
  <!-- Texto de fondo grande -->
  <div
    class="absolute inset-0 flex items-center justify-between px-2 sm:px-8 select-none pointer-events-none"
  >
    <div
      id="back-text"
      class="text-gray-600 font-black text-[6rem] sm:text-[8rem] md:text-[12rem] lg:text-[16rem] xl:text-[20rem] leading-none opacity-20 sm:opacity-30 -translate-x-8 sm:-translate-x-12 md:-translate-x-16"
    >
      BACK
    </div>
    <div
      id="end-text"
      class="text-gray-600 font-black text-[6rem] sm:text-[8rem] md:text-[12rem] lg:text-[16rem] xl:text-[20rem] leading-none opacity-20 sm:opacity-30"
    >
      END
    </div>
  </div>

  <!-- Contenido principal -->
  <div class="relative z-10 text-center max-w-4xl mx-auto">
    <h1
      id="titulo"
      class="text-white text-2xl sm:text-3xl md:text-4xl lg:text-6xl font-bold mb-4"
    >
      I'm Alexis Sotomayor
    </h1>
    <p class="text-gray-300 text-base sm:text-lg md:text-xl mb-2">
      Full Stack Developer | AI Enthusiast
    </p>
    <p class="text-gray-400 text-sm sm:text-base">
      Python • React • AWS • AI/ML
    </p>
  </div>
</section>
