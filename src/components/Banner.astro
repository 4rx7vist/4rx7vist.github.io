---

---

<section
  id="hero-section"
  class="bg-[#08080a] min-h-screen flex items-center justify-center relative overflow-hidden px-6 sm:px-12 pt-24"
>
  <!-- Background Parallax Text (Outline Style) -->
  <div
    class="absolute inset-0 flex items-center justify-center select-none pointer-events-none z-0"
  >
    <div class="flex w-full max-w-7xl mx-auto justify-between px-4">
      <div
        id="back-text"
        class="outline-text font-black text-[6rem] sm:text-[10rem] md:text-[14rem] lg:text-[18rem] leading-none opacity-20 pointer-events-auto"
      >
        PORT
      </div>
      <div
        id="end-text"
        class="outline-text font-black text-[6rem] sm:text-[10rem] md:text-[14rem] lg:text-[18rem] leading-none opacity-20 pointer-events-auto"
      >
        VAULT
      </div>
    </div>
  </div>

  <!-- Content Grid -->
  <div class="relative z-10 w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- Left: Typography & Copy -->
    <div class="lg:col-span-7 text-left flex flex-col items-start">
      <!-- Tagline -->
      <div class="overflow-hidden mb-4">
        <span id="hero-tag" class="block text-xs sm:text-sm font-bold tracking-[0.3em] text-purple-400 uppercase">
          <span class="lang-en-text">Tech Solutions Studio</span>
          <span class="lang-es-text">Estudio de Soluciones Tech</span>
        </span>
      </div>

      <!-- Main Headline (Reveal style) -->
      <h1
        id="hero-title"
        class="text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-[1.1] tracking-tight mb-6"
      >
        <div class="overflow-hidden block py-1">
          <span class="reveal-line block lang-en-text">We build</span>
          <span class="reveal-line block lang-es-text">Creamos</span>
        </div>
        <div class="overflow-hidden block py-1">
          <span class="reveal-line block text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 lang-en-text">exceptional</span>
          <span class="reveal-line block text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 lang-es-text">productos</span>
        </div>
        <div class="overflow-hidden block py-1">
          <span class="reveal-line block lang-en-text">digital products.</span>
          <span class="reveal-line block lang-es-text">digitales excepcionales.</span>
        </div>
      </h1>

      <!-- Description -->
      <div class="overflow-hidden mb-10 max-w-xl">
        <p
          id="hero-desc"
          class="text-gray-400 text-base sm:text-lg md:text-xl font-light leading-relaxed"
        >
          <span class="lang-en-text">Custom software engineering, high-performance system integrations, and automated workflows designed to drive enterprise business growth.</span>
          <span class="lang-es-text">Ingeniería de software a medida, integraciones de alto rendimiento y flujos automatizados diseñados para impulsar el crecimiento de tu negocio.</span>
        </p>
      </div>
      
      <!-- CTA Buttons -->
      <div id="hero-ctas" class="flex flex-wrap gap-4 items-center">
        <a
          href="#projects"
          class="magnetic-target bg-white text-black hover:bg-purple-500 hover:text-white font-bold py-4 px-8 rounded-full shadow-lg shadow-white/5 hover:shadow-purple-500/30 transition-all duration-300 text-center text-sm"
        >
          <span class="lang-en-text">Explore Solutions</span>
          <span class="lang-es-text">Ver Soluciones</span>
        </a>
        <a
          href="#contact"
          class="magnetic-target bg-transparent border-2 border-white/20 hover:border-white/80 text-white font-bold py-4 px-8 rounded-full hover:bg-white/5 transition-all duration-300 text-center text-sm"
        >
          <span class="lang-en-text">Build Your Solution</span>
          <span class="lang-es-text">Construye Tu Solución</span>
        </a>
      </div>
    </div>

    <!-- Right: Interactive Glassmorphic Visual Element -->
    <div class="lg:col-span-5 flex justify-center items-center select-none">
      <div class="hero-visual-container relative w-[320px] h-[320px] sm:w-[400px] sm:h-[400px] flex items-center justify-center">
        <!-- Background glowing backdrops -->
        <div class="absolute w-72 h-72 rounded-full bg-purple-600/20 blur-3xl -z-10 animate-pulse"></div>
        <div class="absolute w-48 h-48 rounded-full bg-blue-500/10 blur-3xl -z-10 animate-ping" style="animation-duration: 4s;"></div>

        <!-- Glass Sphere -->
        <div id="interactive-sphere" class="glass-sphere pointer-events-auto">
          <!-- Internal light reflection -->
          <div class="sphere-highlight"></div>
          <!-- Internal glowing floating core -->
          <div id="sphere-core" class="sphere-core"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Outline Text Styling */
  .outline-text {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.08);
  }

  /* Glass Sphere styling */
  .glass-sphere {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 20px 40px rgba(255, 255, 255, 0.15), 
                inset 0 -20px 45px rgba(0, 0, 0, 0.6), 
                0 30px 60px rgba(168, 85, 247, 0.12);
    position: relative;
    overflow: hidden;
    will-change: transform;
  }

  .sphere-highlight {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle at 25% 25%, rgba(255, 255, 255, 0.35) 0%, transparent 60%);
    pointer-events: none;
  }

  .sphere-core {
    position: absolute;
    top: 25%;
    left: 25%;
    width: 50%;
    height: 50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.8) 0%, rgba(59, 130, 246, 0.5) 50%, transparent 100%);
    filter: blur(10px);
    mix-blend-mode: screen;
    will-change: transform;
  }

  /* Reveal line helpers */
  .reveal-line {
    transform: translateY(100%);
    will-change: transform;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // 1. Interactive 3D Sphere Hover Parallax
  function initSphereParallax() {
    const sphere = document.getElementById("interactive-sphere");
    const core = document.getElementById("sphere-core");
    const section = document.getElementById("hero-section");

    if (!sphere || !core || !section) return;

    // Gentle float animation on load
    gsap.to(sphere, {
      y: -12,
      duration: 3,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut"
    });

    gsap.to(core, {
      scale: 1.15,
      x: -5,
      y: 5,
      duration: 4,
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut"
    });

    // Mouse movement interactive tilt
    section.addEventListener("mousemove", (e) => {
      const rect = section.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;

      // Parallax effect on sphere
      gsap.to(sphere, {
        x: x * 0.05,
        y: y * 0.05 - 6, // account for floating offset
        rotateY: x * 0.06,
        rotateX: -y * 0.06,
        duration: 0.8,
        ease: "power2.out"
      });

      // Opposite effect on internal core to simulate depth
      gsap.to(core, {
        x: -x * 0.08,
        y: -y * 0.08,
        duration: 0.8,
        ease: "power2.out"
      });
    });

    // Reset on mouse leave
    section.addEventListener("mouseleave", () => {
      gsap.to(sphere, {
        x: 0,
        rotateY: 0,
        rotateX: 0,
        duration: 1.2,
        ease: "power3.out"
      });
      gsap.to(core, {
        x: 0,
        y: 0,
        duration: 1.2,
        ease: "power3.out"
      });
    });
  }

  // 2. Load Entrance Animations
  function runEntranceAnimations() {
    const tl = gsap.timeline();

    tl.to(".reveal-line", {
      y: "0%",
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out"
    })
    .fromTo("#hero-tag", {
      y: 20,
      opacity: 0
    }, {
      y: 0,
      opacity: 1,
      duration: 0.8,
      ease: "power3.out"
    }, "-=1.0")
    .fromTo("#hero-desc", {
      y: 30,
      opacity: 0
    }, {
      y: 0,
      opacity: 1,
      duration: 0.8,
      ease: "power3.out"
    }, "-=0.8")
    .fromTo("#hero-ctas", {
      y: 30,
      opacity: 0
    }, {
      y: 0,
      opacity: 1,
      duration: 0.8,
      ease: "back.out(1.7)"
    }, "-=0.6")
    .fromTo("#interactive-sphere", {
      scale: 0.2,
      opacity: 0
    }, {
      scale: 1,
      opacity: 1,
      duration: 1.5,
      ease: "elastic.out(1, 0.75)"
    }, "-=1.2");
  }

  // 3. Background Text Scroll Parallax
  function initBackgroundScrollParallax() {
    const windowWidth = window.innerWidth;
    const separation = windowWidth > 768 ? windowWidth * 0.45 : windowWidth * 0.25;

    gsap.to("#back-text", {
      x: -separation,
      opacity: 0.02,
      scrollTrigger: {
        trigger: "#hero-section",
        start: "top top",
        end: "bottom top",
        scrub: 1
      }
    });

    gsap.to("#end-text", {
      x: separation,
      opacity: 0.02,
      scrollTrigger: {
        trigger: "#hero-section",
        start: "top top",
        end: "bottom top",
        scrub: 1
      }
    });
  }

  // Bind all functions
  document.addEventListener("DOMContentLoaded", () => {
    initSphereParallax();
    runEntranceAnimations();
    initBackgroundScrollParallax();
  });

  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(() => {
      initSphereParallax();
      runEntranceAnimations();
      initBackgroundScrollParallax();
    }, 100);
  }
</script>
