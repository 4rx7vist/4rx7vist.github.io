---
const achievements = [
  "Flipkart Grid 6.0 — Top 20 All India, Information Security Track (2024)",
  "IIT-Bombay — National Finalist, UNESCO Supply Connect (2024)",
  "SAP Hackfest — National Finalist, High-Availability Platform Design (2024)",
  "Google Code-In — International Finisher (2017, 2019) for Open-Source Contributions",
  "NatWest Group — Software Engineer Intern (2025 - Present)"
]
---

<section class="bg-black text-gray-500 py-8">
  <div class="max-w-4xl mx-auto px-8 md:px-4">
    <h3 class="text-xs text-gray-400 font-semibold tracking-wider mb-6">AWARDS X<br>RECOGNITION</h3>
    
    <div class="space-y-0">
      <div class="w-full h-px bg-gray-600 mb-6"></div>
      
      {achievements.map((achievement, index) => (
        <>
          <div class="py-2">
            <p class="text-base text-gray-500 leading-relaxed">
              {achievement}
            </p>
          </div>
          {index < achievements.length - 1 && (
            <div class="w-full h-px bg-gray-600"></div>
          )}
        </>
      ))}
      
      <div class="w-full h-px bg-gray-600 mt-6"></div>
    </div>
  </div>
</section>