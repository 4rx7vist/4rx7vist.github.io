<section id="achievements" class="bg-[#030712] pt-32 pb-12 relative overflow-hidden">
  <!-- Ambient glow -->
  <div class="absolute top-1/2 left-10 w-96 h-96 bg-blue-900/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-12 relative z-10">
    <!-- Header -->
    <div class="mb-20 text-left max-w-3xl">
      <span class="text-xs font-bold tracking-[0.3em] text-blue-400 uppercase mb-3 block">
        <span class="lang-en-text">System & Architecture</span>
        <span class="lang-es-text">Sistema y Arquitectura</span>
      </span>
      <h2 class="text-white text-4xl sm:text-5xl md:text-6xl font-black leading-tight tracking-tight mb-6">
        <span class="lang-en-text">Backend & <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-400">Infrastructure</span>.</span>
        <span class="lang-es-text">Backend e <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-400">Infraestructura</span>.</span>
      </h2>
      <p class="text-gray-400 text-lg font-light leading-relaxed">
        <span class="lang-en-text">Designing robust server ecosystems, secure APIs, optimized databases, and automated pipelines built to scale.</span>
        <span class="lang-es-text">Diseñamos ecosistemas de servidores robustos, APIs seguras, bases de datos optimizadas y pipelines automatizados listos para escalar.</span>
      </p>
    </div>

    <!-- Backend 3D Laptop Showcase Section -->
    <div id="backend-showcase" class="mb-0 py-16 px-8 md:px-16 bg-[#0b1120]/30 border border-white/5 rounded-[2rem] overflow-hidden relative">
      <!-- Glow effects -->
      <div class="absolute -top-12 -left-12 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-8 -right-8 w-48 h-48 bg-blue-500/8 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Backend copy & features -->
        <div class="lg:col-span-5 text-left z-10">
          <span class="text-xs font-bold tracking-[0.3em] text-blue-400 uppercase mb-3 block">
            <span class="lang-en-text">System Architecture</span>
            <span class="lang-es-text">Arquitectura de Software</span>
          </span>
          <h3 class="text-3xl sm:text-4xl font-black text-white mb-6 leading-tight tracking-tight">
            <span class="lang-en-text">Advanced <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-400">System Design</span></span>
            <span class="lang-es-text">Diseño de <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-400">Sistemas</span></span>
          </h3>
          <p class="text-gray-400 font-light leading-relaxed mb-8 text-base">
            <span class="lang-en-text">We develop custom solutions to optimize, automate, and scale your business operations using cutting-edge technology.</span>
            <span class="lang-es-text">Desarrollamos soluciones a medida para optimizar, automatizar y escalar las operaciones de tu negocio con tecnología de punta.</span>
          </p>

          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-blue-500/10 border border-blue-500/25 flex items-center justify-center text-blue-400 text-xs font-bold shrink-0 mt-0.5">✓</div>
              <div>
                <strong class="text-white text-sm font-semibold block">
                  <span class="lang-en-text">Metrics & Accounting</span>
                  <span class="lang-es-text">Métricas y Contabilización</span>
                </strong>
                <span class="text-gray-400 text-xs font-light block">
                  <span class="lang-en-text">Management systems for real-time metrics visualization and accounting control.</span>
                  <span class="lang-es-text">Sistemas de gestión para visualización de métricas y control contable.</span>
                </span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-blue-500/10 border border-blue-500/25 flex items-center justify-center text-blue-400 text-xs font-bold shrink-0 mt-0.5">✓</div>
              <div>
                <strong class="text-white text-sm font-semibold block">
                  <span class="lang-en-text">AI Agents Integration</span>
                  <span class="lang-es-text">Agentes de IA</span>
                </strong>
                <span class="text-gray-400 text-xs font-light block">
                  <span class="lang-en-text">Integration of artificial intelligence to empower processes and automation.</span>
                  <span class="lang-es-text">Integración de inteligencia artificial para potenciar procesos y automatización.</span>
                </span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-cyan-500/10 border border-cyan-500/25 flex items-center justify-center text-cyan-400 text-xs font-bold shrink-0 mt-0.5">✓</div>
              <div>
                <strong class="text-white text-sm font-semibold block">
                  <span class="lang-en-text">Payment Gateways</span>
                  <span class="lang-es-text">Pasarelas de Pago</span>
                </strong>
                <span class="text-gray-400 text-xs font-light block">
                  <span class="lang-en-text">Secure implementation of online billing methods and financial transactions.</span>
                  <span class="lang-es-text">Implementación segura de métodos de cobro en línea y transacciones.</span>
                </span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-sky-500/10 border border-sky-500/25 flex items-center justify-center text-sky-400 text-xs font-bold shrink-0 mt-0.5">✓</div>
              <div>
                <strong class="text-white text-sm font-semibold flex items-center gap-2">
                  <span class="lang-en-text">SRI Electronic Billing</span>
                  <span class="lang-es-text">Facturación SRI</span>
                  <span class="text-sky-400/80 text-[9px] uppercase px-1.5 py-0.5 rounded-full border border-sky-500/30">
                    <span class="lang-en-text">Upcoming</span>
                    <span class="lang-es-text">Próximamente</span>
                  </span>
                </strong>
                <span class="text-gray-400 text-xs font-light block">
                  <span class="lang-en-text">Direct integration with SRI for automated electronic billing.</span>
                  <span class="lang-es-text">Integración directa con el SRI para facturación electrónica automatizada.</span>
                </span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Right: 3D Mac canvas -->
        <div class="lg:col-span-7 flex justify-center items-center relative h-[360px] sm:h-[450px]">
          <div id="three-canvas-container" class="w-full h-full relative">
            <canvas id="laptop-canvas" class="w-full h-full block rounded-2xl"></canvas>

            <!-- Scroll hint overlay -->
            <div id="scroll-hint" class="absolute bottom-4 right-4 text-[10px] text-gray-500 tracking-wider font-mono select-none pointer-events-none uppercase bg-[#030712]/80 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/5 flex items-center gap-1.5 transition-opacity duration-500">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse inline-block"></span>
              Scroll to open
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

  gsap.registerPlugin(ScrollTrigger);



  // ─────────────────────────────────────────────────────────────────
  // 2. Three.js MacBook Pro 3D Model + Scroll Animation
  // ─────────────────────────────────────────────────────────────────
  function initThreeLaptop() {
    const container = document.getElementById("three-canvas-container") as HTMLElement | null;
    const canvas = document.getElementById("laptop-canvas") as HTMLCanvasElement | null;
    const scrollHint = document.getElementById("scroll-hint") as HTMLElement | null;
    if (!container || !canvas) return;

    let width = container.clientWidth;
    let height = container.clientHeight;

    // ── Scene, Camera, Renderer ──
    const scene = new THREE.Scene();

    // Camera: slightly elevated, slightly right-of-center → gives front-left 3/4 view
    // (we're looking at the laptop from its front-right, so we see the screen and left side)
    const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 100);
    camera.position.set(1.2, 1.0, 7.5);
    camera.lookAt(0.3, -0.3, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.8;

    // ── Lighting — Rich, premium, well-lit ──
    // Strong ambient so the metal body is always visible
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.0);
    scene.add(ambientLight);

    // Main key light from upper-left (white)
    const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
    keyLight.position.set(4, 10, 6);
    keyLight.castShadow = true;
    scene.add(keyLight);

    // Front fill light — warm white, removes dark shadows
    const fillLight = new THREE.DirectionalLight(0xf0f4ff, 1.4);
    fillLight.position.set(-3, 4, 8);
    scene.add(fillLight);

    // Purple screen glow (grows as lid opens)
    const screenLight = new THREE.PointLight(0x60a5fa, 2.0, 8);
    screenLight.position.set(0, 0.8, 1.0);
    scene.add(screenLight);

    // Blue under-rim accent (gives depth to the base)
    const rimLight = new THREE.DirectionalLight(0x6366f1, 1.2);
    rimLight.position.set(-6, 1, -4);
    scene.add(rimLight);

    // Warm top highlight (simulates studio ceiling light)
    const topLight = new THREE.DirectionalLight(0xffffff, 0.8);
    topLight.position.set(0, 12, 0);
    scene.add(topLight);

    // ── Subtle Floor ── (NOT Matrix grid — clean reflective surface)
    // Very sparse thin grid, almost invisible
    const gridHelper = new THREE.GridHelper(12, 12, 0x1e3a8a, 0x020617);
    gridHelper.position.y = -0.65;
    const gridMat = gridHelper.material as THREE.LineBasicMaterial;
    gridMat.transparent = true;
    gridMat.opacity = 0.18;
    scene.add(gridHelper);

    // Dark reflective floor plane (gives the premium studio look)
    const floorGeo = new THREE.PlaneGeometry(14, 14);
    const floorMat = new THREE.MeshStandardMaterial({
      color: 0x030712,
      metalness: 0.3,
      roughness: 0.7,
      transparent: true,
      opacity: 0.85,
    });
    const floorMesh = new THREE.Mesh(floorGeo, floorMat);
    floorMesh.rotation.x = -Math.PI / 2;
    floorMesh.position.y = -0.66;
    floorMesh.receiveShadow = true;
    scene.add(floorMesh);

    // Soft purple glow on floor (very subtle halo under the laptop)
    const haloGeo = new THREE.PlaneGeometry(4, 2.5);
    const haloMat = new THREE.MeshBasicMaterial({
      color: 0x2563eb,
      transparent: true,
      opacity: 0.06,
      side: THREE.DoubleSide,
    });
    const haloMesh = new THREE.Mesh(haloGeo, haloMat);
    haloMesh.rotation.x = -Math.PI / 2;
    haloMesh.position.y = -0.64;
    scene.add(haloMesh);

    // ── Screen Canvas Texture (Backend Dashboard) ──
    const screenCanvas = document.createElement("canvas");
    screenCanvas.width = 400;
    screenCanvas.height = 640;
    const ctx = screenCanvas.getContext("2d")!;
    const screenTexture = new THREE.CanvasTexture(screenCanvas);
    screenTexture.center.set(0.5, 0.5);
    screenTexture.rotation = -Math.PI / 2;
    screenTexture.wrapS = THREE.RepeatWrapping;
    screenTexture.repeat.x = -1;

    // ── Image slideshow variables ──
    const imageUrls = [
      `${baseUrl}images/Agents.png`,
      `${baseUrl}images/CRM.png`,
      `${baseUrl}images/Integrations.png`
    ];
    const images: HTMLImageElement[] = [];
    let imagesLoaded = 0;

    imageUrls.forEach((url, index) => {
      const img = new Image();
      img.src = url;
      img.onload = () => {
        images[index] = img;
        imagesLoaded++;
      };
    });

    let currentImageIndex = 0;
    let nextImageIndex = 0;
    let transitionProgress = 1.0;
    let lastTransitionTime = Date.now();
    const slideDuration = 4000; // 4 seconds per slide
    const fadeDuration = 1000;  // 1 second transition

    function drawScreenContent() {
      if (!ctx) return;

      const now = Date.now();
      const timeSinceLast = now - lastTransitionTime;

      if (imagesLoaded === imageUrls.length) {
        if (transitionProgress >= 1.0) {
          if (timeSinceLast >= slideDuration) {
            nextImageIndex = (currentImageIndex + 1) % imageUrls.length;
            transitionProgress = 0.0;
            lastTransitionTime = now;
          }
        } else {
          transitionProgress = Math.min(1.0, timeSinceLast / fadeDuration);
          if (transitionProgress >= 1.0) {
            currentImageIndex = nextImageIndex;
          }
        }
      }

      // Clear the canvas
      ctx.clearRect(0, 0, screenCanvas.width, screenCanvas.height);
      ctx.save();

      // Rounded screen corners clipping mask
      ctx.beginPath();
      roundRect(ctx, 0, 0, screenCanvas.width, screenCanvas.height, 22);
      ctx.clip();

      // Translate to center of vertical canvas
      ctx.translate(screenCanvas.width / 2, screenCanvas.height / 2);
      // Rotate 90 degrees clockwise to align with Three.js rotation of -90 degrees
      ctx.rotate(Math.PI / 2);
      // Mirror horizontally to cancel out Three.js mirroring
      ctx.scale(-1, 1);

      const targetW = 640;
      const targetH = 400;

      if (imagesLoaded > 0 && images[currentImageIndex]) {
        if (transitionProgress < 1.0 && images[nextImageIndex]) {
          // Draw current image centered
          ctx.globalAlpha = 1.0 - transitionProgress;
          ctx.drawImage(images[currentImageIndex], -targetW / 2, -targetH / 2, targetW, targetH);

          // Draw next image centered
          ctx.globalAlpha = transitionProgress;
          ctx.drawImage(images[nextImageIndex], -targetW / 2, -targetH / 2, targetW, targetH);
        } else {
          ctx.globalAlpha = 1.0;
          ctx.drawImage(images[currentImageIndex], -targetW / 2, -targetH / 2, targetW, targetH);
        }
      } else {
        // Fallback wallpaper gradient
        const wallGrad = ctx.createRadialGradient(
          0, 0, 50,
          0, 0, targetW * 0.8
        );
        wallGrad.addColorStop(0, "#0e1a3a");
        wallGrad.addColorStop(0.5, "#050912");
        wallGrad.addColorStop(1, "#020306");
        ctx.fillStyle = wallGrad;
        ctx.fillRect(-targetW / 2, -targetH / 2, targetW, targetH);
      }

      ctx.restore();
      screenTexture.needsUpdate = true;
    }

    // Helper: rounded rect
    function roundRect(c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      c.beginPath();
      c.moveTo(x + r, y);
      c.lineTo(x + w - r, y);
      c.quadraticCurveTo(x + w, y, x + w, y + r);
      c.lineTo(x + w, y + h - r);
      c.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      c.lineTo(x + r, y + h);
      c.quadraticCurveTo(x, y + h, x, y + h - r);
      c.lineTo(x, y + r);
      c.quadraticCurveTo(x, y, x + r, y);
      c.closePath();
    }

    const screenMat = new THREE.MeshBasicMaterial({
      map: screenTexture,
      transparent: true,
      side: THREE.DoubleSide,
      toneMapped: false
    });

    // ── MacBook Group ──
    const laptopGroup = new THREE.Group();
    scene.add(laptopGroup);

    // Start: FAR left (off-screen), closed, slight angle
    laptopGroup.position.set(-5.5, -0.2, 0);
    laptopGroup.rotation.set(0.05, -0.15, 0.02);

    let baseNode: THREE.Group = new THREE.Group();
    laptopGroup.add(baseNode);

    const gltfLoader = new GLTFLoader();
    gltfLoader.load(`${baseUrl}assets/macbook_pro_m5_max_16_inch_2026.glb`, (gltf) => {
      const model = gltf.scene;
      model.scale.set(0.11, 0.11, 0.11);
      model.rotation.x = 0;
      model.position.set(0, -0.2, -0.1);
      baseNode.add(model);

      let lidMeshRef: THREE.Object3D | null = null;
      model.traverse((child) => {
        if (child.name === "VCQqxpxkUlzqcJI_62_97") {
          lidMeshRef = child;
        }
        if (child instanceof THREE.Mesh) {
          child.castShadow = true;
          child.receiveShadow = true;
          if (child.name === "Object_183" || child.name === "Object_192") {
            child.material = screenMat;
            child.material.side = THREE.DoubleSide;
          }
        }
      });

      // ── Lid reparenting ──
      let lidPivot: THREE.Group | null = null;
      let closedRotX = 1.88;

      if (lidMeshRef) {
        const lid = lidMeshRef as THREE.Object3D;
        
        // Save original rotation and temporarily reset to prevent Box3 skewing
        const origRot = laptopGroup.rotation.clone();
        laptopGroup.rotation.set(0, 0, 0);
        
        // Force update world matrices in un-rotated state
        laptopGroup.updateMatrixWorld(true);
        model.updateMatrixWorld(true);

        const bbox = new THREE.Box3().setFromObject(lid);
        const hingeWorld = new THREE.Vector3(
          (bbox.min.x + bbox.max.x) / 2,
          bbox.min.y,
          bbox.max.z
        );

        lidPivot = new THREE.Group();
        const hingeLocal = model.worldToLocal(hingeWorld.clone());
        lidPivot.position.copy(hingeLocal);
        model.add(lidPivot);
        lidPivot.attach(lid);
        lidPivot.rotation.x = closedRotX;

        // Restore original rotation and update matrices
        laptopGroup.rotation.copy(origRot);
        laptopGroup.updateMatrixWorld(true);
      }

      // Build GSAP timeline
      const lidDummy = { x: closedRotX };
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#backend-showcase",
          start: "top 70%",
          end: "center center",
          scrub: 1.0,
          onUpdate: (self) => {
            if (scrollHint) {
              scrollHint.style.opacity = self.progress > 0.1 ? "0" : "1";
            }
            screenLight.intensity = 0.5 + self.progress * 6.0;
            haloMesh.position.x = laptopGroup.position.x;
          },
        },
      });

      tl
        .to(laptopGroup.position,
          { x: 0.6, y: -0.22, z: 0.0, ease: "power2.out", duration: 1.0 }, 0)
        .to(laptopGroup.rotation,
          { y: -0.25, x: 0.08, z: 0.0, ease: "power2.out", duration: 1.0 }, 0)
        .to(lidDummy,
          {
            x: 0,
            ease: "power2.inOut",
            duration: 1.0,
            onUpdate: () => {
              if (lidPivot) lidPivot.rotation.x = lidDummy.x;
            }
          }, 0);

    }, undefined, (error) => {
      console.error("Error loading MacBook GLB:", error);
    });

    // ── Render Loop ──
    let raf: number;
    let isVisible = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isVisible = entry.isIntersecting;
      });
    }, { threshold: 0.0, rootMargin: "100px" });
    observer.observe(container);

    function animate() {
      raf = requestAnimationFrame(animate);
      if (!isVisible) return; // Pause rendering if out of view
      drawScreenContent();
      renderer.render(scene, camera);
    }
    animate();

    // ── Resize ──
    function handleResize() {
      if (!container) return;
      width = container.clientWidth;
      height = container.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }
    window.addEventListener("resize", handleResize);

    // Cleanup
    return () => {
      cancelAnimationFrame(raf);
      observer.disconnect();
      window.removeEventListener("resize", handleResize);
      ScrollTrigger.getAll().forEach(t => t.kill());
      renderer.dispose();
    };
  }

  // ── Bootstrap ──
  function init() {
    initThreeLaptop();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

<style>
  #scroll-hint {
    transition: opacity 0.5s ease;
  }
</style>
