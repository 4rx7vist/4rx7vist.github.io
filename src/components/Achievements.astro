---
const achievements = [
  "🥇 First Place, Food Bank Hackathon - Quito (2025)",
  "Selected Team, Road to Start Hack Challenge - Quito (2025)",
  "Linux Essentials Certified Systems Engineering - NDG Linux",
  "Advanced Data Science Analytics Certification - Cisco",
  "Enterprise Network Architecture Certified - Cisco",
  "Scrum Foundation Professional Certified Development - SFPC",
];
---

<section class="bg-black text-gray-500 py-12">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-10 relative">
      <h2 class="text-white text-3xl md:text-4xl font-bold tracking-tight mb-4">
        <span
          class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-cyan-300"
        >
          Milestones & Recognition
        </span>
      </h2>
      <p class="text-gray-400 text-sm md:text-base mt-2 mb-3 tracking-wide">
        Key industry recognition and professional certifications that validate our technical standards
      </p>
      <div
        class="h-0.5 w-24 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full opacity-80"
      >
      </div>
    </div>

    <div class="space-y-0">
      <div class="w-full h-px bg-gray-600 mb-2"></div>

      {
        achievements.map((achievement, index) => (
          <>
            <div class="py-2">
              <p class="text-base text-gray-300 leading-relaxed">
                {achievement}
              </p>
            </div>
            {index < achievements.length - 1 && (
              <div class="w-full h-px bg-gray-700" />
            )}
          </>
        ))
      }

      <div class="w-full h-px bg-gray-600 mb-2"></div>
    </div>
  </div>
</section>
