  </div>
</footer>

<script>
  // Actualiza la hora de Quito, Ecuador (GMT-5) cada segundo
  function updateClock() {
    const now = new Date();
    const utc = now.getTime() + now.getTimezoneOffset() * 60000;
    const quitoTime = new Date(utc - 5 * 3600000);
    const hours = String(quitoTime.getHours()).padStart(2, "0");
    const minutes = String(quitoTime.getMinutes()).padStart(2, "0");
    document.getElementById("footer-clock").textContent = `${hours}:${minutes}`;
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>
