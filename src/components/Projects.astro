---
// Array de proyectos / soluciones
const projects = [
  {
    id: 1,
    title_en: "Donation & Operations Platform",
    title_es: "Plataforma de Donaciones y Operaciones",
    description_en: "We engineered an automated donation and operations management engine for the Food Bank of Quito. It synchronizes CRM operations, handles secure multi-gateway transactions, and automates tracking reports in real-time.",
    description_es: "Desarrollamos un motor automatizado de gestión de donaciones y operaciones para el Banco de Alimentos de Quito. Sincroniza CRM, maneja transacciones multi-pasarela y automatiza reportes en tiempo real.",
    features_en: [
      "60% reduction in donation processing time",
      "Integrated 4 national and international payment gateways",
      "Automated Monday.com workflow synchronization",
      "40% increase in operational and donation throughput"
    ],
    features_es: [
      "60% de reducción en el tiempo de procesamiento de donaciones",
      "Integración de 4 pasarelas de pago nacionales e internacionales",
      "Sincronización automatizada con Monday.com",
      "40% de aumento en rendimiento operacional y de donaciones"
    ],
    image: "/images/baq.png",
    technologies: ["Next.js", "Nest.js", "Supabase", "TypeScript", "Monday.com API"],
    category_en: "Fintech & NGO",
    category_es: "Fintech & ONG"
  },
  {
    id: 2,
    title_en: "Clinic ERP & Management System",
    title_es: "Sistema ERP y Gestión de Clínica",
    description_en: "A secure, end-to-end administration platform designed for medical clinics. It manages patient electronic health records, automates appointment scheduling with SMS/email reminders, and generates electronic billing receipts instantly.",
    description_es: "Plataforma de administración integral para clínicas médicas. Gestiona historias clínicas electrónicas, automatiza agendas con recordatorios SMS/email y genera comprobantes de facturación electrónica al instante.",
    features_en: [
      "30% reduction in clinic administrative friction",
      "Automated appointment notification engine",
      "Integrated electronic billing compliant with local laws",
      "Centralized clinical analytics dashboard"
    ],
    features_es: [
      "30% de reducción en la fricción administrativa de la clínica",
      "Motor automatizado de notificaciones de citas",
      "Facturación electrónica integrada conforme a la normativa local",
      "Panel de analítica clínica centralizado"
    ],
    image: "/images/odontologica.png",
    technologies: ["React", "Node.js", "Express", "PostgreSQL"],
    category_en: "ERP & Healthcare",
    category_es: "ERP & Salud"
  },
  {
    id: 3,
    title_en: "Scalable Cloud SaaS Architecture",
    title_es: "Arquitectura Cloud SaaS Escalable",
    description_en: "An enterprise-grade high-availability dashboard that connects real-time data from IoT smart hubs and distributed team collaboration workspaces, featuring live socket communication and secure cloud storage.",
    description_es: "Dashboard empresarial de alta disponibilidad que conecta datos en tiempo real de hubs IoT y espacios de trabajo distribuidos, con comunicación en vivo por sockets y almacenamiento cloud seguro.",
    features_en: [
      "High-performance real-time data sync with WebSockets",
      "Automated cloud backup and 99.9% uptime architecture",
      "Custom RESTful APIs and microservices orchestration",
      "Role-based access control and advanced security layers"
    ],
    features_es: [
      "Sincronización de datos en tiempo real con WebSockets de alto rendimiento",
      "Respaldo cloud automatizado y arquitectura con 99.9% de disponibilidad",
      "APIs RESTful personalizadas y orquestación de microservicios",
      "Control de acceso por roles y capas de seguridad avanzadas"
    ],
    image: "https://images.unsplash.com/photo-1551434678-e076c223a692?w=600&h=400&fit=crop&crop=center",
    technologies: ["Next.js", "Node.js", "Docker", "Socket.io", "AWS / Supabase"],
    category_en: "Cloud & SaaS",
    category_es: "Cloud & SaaS"
  },
];
---

<section class="projects-section py-32 bg-[#08080a] relative overflow-hidden" id="projects">
  <!-- Glowing accent backdrop -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-purple-900/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="w-full max-w-7xl px-6 sm:px-12 mx-auto relative z-10">
    <!-- Header Section -->
    <div class="section-header text-left mb-20 max-w-3xl">
      <span class="text-xs font-bold tracking-[0.3em] text-purple-400 uppercase mb-3 block">
        <span class="lang-en-text">Selected Works</span>
        <span class="lang-es-text">Trabajos Destacados</span>
      </span>
      <h2 class="section-title text-4xl sm:text-5xl md:text-6xl font-black text-white leading-tight tracking-tight mb-6">
        <span class="lang-en-text">Solutions we have <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400">engineered</span>.</span>
        <span class="lang-es-text">Soluciones que hemos <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400">construido</span>.</span>
      </h2>
      <p class="section-subtitle text-lg sm:text-xl text-gray-400 font-light leading-relaxed">
        <span class="lang-en-text">Discover how we build custom platforms, robust integrations, and high-performance applications that solve operational challenges.</span>
        <span class="lang-es-text">Descubre cómo construimos plataformas personalizadas, integraciones robustas y aplicaciones de alto rendimiento que resuelven desafíos operacionales.</span>
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8">
      {projects.map((project) => (
        <div class="project-card group relative bg-[#0e0e12]/40 backdrop-blur-md rounded-3xl p-6 border border-white/5 hover:border-purple-500/25 transition-all duration-500 hover:shadow-3xl hover:shadow-purple-500/5 flex flex-col justify-between" data-project-id={project.id}>
          <div>
            <!-- Category Badge -->
            <div class="mb-6 flex justify-between items-center">
              <span class="category-badge text-[10px] font-bold tracking-widest bg-white/5 border border-white/10 text-purple-300 px-3 py-1.5 rounded-full uppercase">
                <span class="lang-en-text">{project.category_en}</span>
                <span class="lang-es-text">{project.category_es}</span>
              </span>
            </div>

            <!-- Image Container -->
            <div class="card-image relative overflow-hidden rounded-2xl mb-8 aspect-[16/10] bg-zinc-950">
              <img
                src={project.image} 
                alt={project.title_en}
                class="w-full h-full object-cover transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:scale-105 opacity-85 group-hover:opacity-100"
                loading="lazy"
              />
              
              <!-- Hover Overlay with magnetic CTAs -->
              <div class="image-overlay absolute inset-0 bg-black/75 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center">
                <div class="overlay-buttons flex flex-col gap-3 px-6 w-full max-w-[240px]">
                  <a 
                    href="#contact" 
                    class="magnetic-target btn-demo flex items-center justify-center gap-2 bg-white text-black px-5 py-3.5 rounded-full font-bold hover:bg-purple-500 hover:text-white transition-all duration-300 text-sm text-center"
                  >
                    <span class="lang-en-text">Discuss Project</span>
                    <span class="lang-es-text">Hablar del Proyecto</span>
                  </a>
                  <a 
                    href="https://github.com/Alexiskeepcoding" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="magnetic-target btn-code flex items-center justify-center gap-2 bg-white/10 border border-white/10 text-white px-5 py-3.5 rounded-full font-bold hover:bg-white/20 transition-all duration-300 text-sm text-center"
                  >
                    <span class="lang-en-text">Source Code</span>
                    <span class="lang-es-text">Código Fuente</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Card Content -->
            <div class="card-content">
              <h3 class="project-title text-2xl font-bold text-white mb-4 group-hover:text-purple-300 transition-colors duration-300 tracking-tight leading-tight">
                <span class="lang-en-text">{project.title_en}</span>
                <span class="lang-es-text">{project.title_es}</span>
              </h3>
              
              <p class="project-description text-gray-400 font-light leading-relaxed mb-6 text-sm">
                <span class="lang-en-text">{project.description_en}</span>
                <span class="lang-es-text">{project.description_es}</span>
              </p>

              {project.features_en && (
                <ul class="project-features text-gray-400 font-light text-xs mb-8 space-y-2 list-none pl-0">
                  {project.features_en.map((feature, i) => (
                    <li class="flex items-start gap-2">
                      <span class="text-purple-400 mt-0.5">•</span>
                      <span class="lang-en-text">{feature}</span>
                      <span class="lang-es-text">{project.features_es[i]}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>

          <!-- Technologies -->
          <div class="technologies flex flex-wrap gap-2 pt-4 border-t border-white/5">
            {project.technologies.map((tech) => (
              <span class="tech-tag bg-white/5 text-gray-400 text-[10px] font-bold tracking-wider px-3 py-1.5 rounded-full border border-white/5 transition-all duration-300">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initProjectsAnimations() {
    gsap.registerPlugin(ScrollTrigger);
    
    // Set initial positions
    gsap.set('.project-card', { opacity: 0, y: 60 });
    gsap.set('.section-title', { opacity: 0, y: 30 });
    gsap.set('.section-subtitle', { opacity: 0, y: 20 });

    // Timeline for header reveal
    const headerTl = gsap.timeline({
      scrollTrigger: {
        trigger: '.projects-section',
        start: 'top 80%',
        toggleActions: 'play none none reverse'
      }
    });

    headerTl
      .to('.section-title', {
        duration: 1,
        opacity: 1,
        y: 0,
        ease: 'power3.out'
      })
      .to('.section-subtitle', {
        duration: 0.8,
        opacity: 1,
        y: 0,
        ease: 'power3.out'
      }, '-=0.6');

    // Staggered reveal for cards
    gsap.to('.project-card', {
      duration: 1.2,
      opacity: 1,
      y: 0,
      stagger: 0.15,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.projects-grid',
        start: 'top 85%',
        toggleActions: 'play none none reverse'
      }
    });

    // Subtly hover dynamic color shifting
    document.querySelectorAll('.project-card').forEach((card) => {
      const techTags = card.querySelectorAll('.tech-tag');
      
      card.addEventListener('mouseenter', () => {
        gsap.to(techTags, {
          duration: 0.3,
          backgroundColor: 'rgba(255, 255, 255, 0.1)',
          borderColor: 'rgba(168, 85, 247, 0.2)',
          color: '#e9d5ff',
          stagger: 0.04,
          ease: 'power2.out'
        });
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(techTags, {
          duration: 0.3,
          backgroundColor: 'rgba(255, 255, 255, 0.05)',
          borderColor: 'rgba(255, 255, 255, 0.05)',
          color: '#9ca3af',
          stagger: 0.04,
          ease: 'power2.out'
        });
      });
    });
  }

  // Init on DOM ready
  document.addEventListener('DOMContentLoaded', initProjectsAnimations);

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setTimeout(initProjectsAnimations, 100);
  }

  window.addEventListener('resize', () => {
    ScrollTrigger.refresh();
  });
</script>

<style>
  /* Base transitions */
  .project-card {
    will-change: transform, border-color, box-shadow;
  }
</style>