---
import { Image } from 'astro:assets';
import Text from './Text.astro';
import ArchitectureDiagram from './systems/ArchitectureDiagram.astro';
import { systems } from '../data/systems';
import { systemMedia } from '../data/system-media';
import { sitePath } from '../utils/paths';
---
<section id="work" class="work page-width" aria-labelledby="work-title">
  <div class="work-heading" data-reveal="heading"><div><p class="section-label"><Text en="SELECTED WORK" es="TRABAJO SELECCIONADO" /></p><h2 id="work-title" class="section-title"><Text en="What I built." es="Lo que construí." /></h2></div><p><Text en="Concrete solutions shaped around each organization's operations." es="Soluciones concretas diseñadas alrededor de las operaciones de cada organización." /></p></div>
  <div class="work-list">
    {systems.map((system, index) => {
      const media = systemMedia[system.slug as keyof typeof systemMedia];
      return <article class:list={['work-item', { reverse: index === 1 }]}>
        <div class="work-media" data-reveal="media">
          {media ? <a href={sitePath(`systems/${system.slug}/`)} aria-label={`Inspect ${system.name.en}`}><Image src={media} alt={system.name.en} widths={[480, 800, 1200].filter(width => width <= media.width)} sizes="(max-width: 800px) calc(100vw - 48px), 55vw" width={Math.min(1200, media.width)} format="webp" loading="lazy" /></a> : <ArchitectureDiagram nodes={system.architecture} compact />}
          <p class="media-caption">{system.imageCaption ? <Text {...system.imageCaption} /> : <Text en="Conceptual architecture · deployment details to be confirmed" es="Arquitectura conceptual · despliegue por confirmar" />}</p>
        </div>
        <div class="work-copy" data-reveal="copy">
          <div class="work-number">SYSTEM {String(index + 1).padStart(2, '0')}<span><Text {...system.systemType} /></span></div>
          <h3><a href={sitePath(`systems/${system.slug}/`)}><Text {...system.name} /></a></h3>
          <p class="work-summary"><Text {...system.summary} /></p>
          <ol class="deliverables">
            {system.deliverables.map((deliverable, deliverableIndex) => <li><span>{String(deliverableIndex + 1).padStart(2, '0')}</span><Text {...deliverable} /></li>)}
          </ol>
          <ul class="solution-tags" aria-label="Solution tags">
            {system.solutionTags.map(tag => <li><Text {...tag} /></li>)}
          </ul>
          <a class="text-link" href={sitePath(`systems/${system.slug}/`)}><Text en="Inspect system" es="Explorar sistema" /><span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </article>;
    })}
  </div>
</section>
<style>
  .work { padding-block: 90px 80px; }
  .work-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 50px; margin-bottom: 58px; }
  .section-label { margin-bottom: 22px; }
  .work-heading > p { font-size: .875rem; max-width: 34ch; color: var(--muted); }
  .work-list { display: grid; gap: 82px; }
  .work-item { display: grid; grid-template-columns: 1.45fr 1fr; gap: 60px; align-items: center; }
  .work-item.reverse { grid-template-columns: 1fr 1.45fr; }
  .reverse .work-media { order: 2; } .reverse .work-copy { order: 1; }
  .work-media { min-width: 0; }
  .work-media > a { display: block; overflow: hidden; border-radius: var(--radius-media); background: var(--soft); }
  .work-media img { width: 100%; height: auto; aspect-ratio: 1.65; object-fit: cover; object-position: center; transition: transform var(--motion-section) var(--ease-out); }
  .reverse .work-media img { aspect-ratio: 1.85; }
  .media-caption { font-size: .6875rem; color: var(--muted); margin-top: 12px; }
  .work-number { display: flex; align-items: center; gap: 18px; font-size: .6875rem; color: var(--blue); letter-spacing: .06em; }
  .work-number > span { color: var(--muted); letter-spacing: 0; }
  h3 { font-size: clamp(1.6rem, 2.3vw, 2.2rem); font-weight: 550; letter-spacing: -.03em; line-height: 1.18; margin-top: 20px; }
  h3 a:hover { color: var(--blue); }
  .work-summary { font-size: .875rem; color: var(--muted); margin-block: 18px 24px; max-width: 42ch; }
  .deliverables { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .deliverables li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; padding-block: 11px; border-bottom: 1px solid var(--line); font-size: .75rem; line-height: 1.5; }
  .deliverables li > span { color: var(--muted); font-size: .6875rem; padding-top: 2px; }
  .solution-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 7px; padding: 0; margin: 18px 0 0; }
  .solution-tags li { padding: 6px 9px; border: 1px solid var(--line); border-radius: var(--radius-control); color: var(--muted); font-size: .6875rem; line-height: 1.2; }
  .work-copy .text-link { margin-top: 23px; border-bottom: 1px solid var(--ink); }
  @media(hover: hover) { .work-media a:hover img { transform: scale(1.025); } }
  @media(max-width: 1100px) { .work-item, .work-item.reverse { gap: 35px; grid-template-columns: 1.2fr 1fr; } .work-item.reverse { grid-template-columns: 1fr 1.2fr; } }
  @media(max-width: 800px) { .work { padding-top: 60px; } .work-heading { align-items: flex-start; flex-direction: column; gap: 22px; margin-bottom: 38px; } .work-heading > p { max-width: 50ch; } .work-item, .work-item.reverse { grid-template-columns: 1fr; gap: 28px; } .reverse .work-media, .reverse .work-copy { order: initial; } .work-list { gap: 65px; } .work-summary { max-width: 60ch; } }
</style>
