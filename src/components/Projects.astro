---
// Array de proyectos - puedes modificar estos datos fácilmente
const projects = [
  {
    id: 1,
    title: "E-Commerce Platform",
    description: "Plataforma de comercio electrónico completa con React y Node.js, sistema de pagos integrado y panel de administración.",
    image: "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=600&h=400&fit=crop&crop=center",
    technologies: ["React", "Node.js", "MongoDB", "Stripe", "Tailwind"],
    demoUrl: "https://demo.com",
    codeUrl: "https://github.com/usuario/proyecto",
    category: "Full Stack"
  },
  {
    id: 2,
    title: "Task Management App",
    description: "Aplicación de gestión de tareas con funcionalidades avanzadas, colaboración en tiempo real y notificaciones.",
    image: "https://images.unsplash.com/photo-1611224923853-80b023f02d71?w=600&h=400&fit=crop&crop=center",
    technologies: ["Vue.js", "Firebase", "Tailwind CSS", "Pinia"],
    demoUrl: "https://demo2.com",
    codeUrl: "https://github.com/usuario/proyecto2",
    category: "Frontend"
  },
  {
    id: 3,
    title: "Weather Dashboard",
    description: "Dashboard del clima con gráficos interactivos, pronósticos detallados y mapas meteorológicos en tiempo real.",
    image: "https://images.unsplash.com/photo-1504608524841-42fe6f032b4b?w=600&h=400&fit=crop&crop=center",
    technologies: ["JavaScript", "Chart.js", "API REST", "CSS3"],
    demoUrl: "https://demo3.com",
    codeUrl: "https://github.com/usuario/proyecto3",
    category: "Frontend"
  },
  {
    id: 4,
    title: "Portfolio Website",
    description: "Sitio web de portafolio personal con animaciones suaves, diseño responsivo y optimización SEO.",
    image: "https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=600&h=400&fit=crop&crop=center",
    technologies: ["Astro", "GSAP", "Tailwind CSS", "TypeScript"],
    demoUrl: "https://demo4.com",
    codeUrl: "https://github.com/usuario/proyecto4",
    category: "Frontend"
  },
  {
    id: 5,
    title: "AI Chat Application",
    description: "Aplicación de chat con inteligencia artificial, procesamiento de lenguaje natural y respuestas contextuales.",
    image: "https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop&crop=center",
    technologies: ["Next.js", "OpenAI API", "Prisma", "PostgreSQL"],
    demoUrl: "https://demo5.com",
    codeUrl: "https://github.com/usuario/proyecto5",
    category: "Full Stack"
  },
  {
    id: 6,
    title: "Mobile Fitness App",
    description: "Aplicación móvil para fitness con seguimiento de ejercicios, planes personalizados y gamificación.",
    image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600&h=400&fit=crop&crop=center",
    technologies: ["React Native", "Redux", "Firebase", "Expo"],
    demoUrl: "https://demo6.com",
    codeUrl: "https://github.com/usuario/proyecto6",
    category: "Mobile"
  }
];
---

<section class="projects-section py-20 bg-black min-h-screen" id="projects">
  <div class="container mx-auto px-6 lg:px-8">
    <!-- Header Section -->
    <div class="section-header text-center mb-16">
      <h2 class="section-title text-4xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 mb-6">
        Mis Proyectos
      </h2>
      <p class="section-subtitle text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
        Una colección de proyectos que demuestran mis habilidades en desarrollo web, aplicaciones móviles y soluciones tecnológicas innovadoras.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 lg:gap-10">
      {projects.map((project) => (
        <div class="project-card group relative bg-white/5 backdrop-blur-xl rounded-2xl p-6 border border-white/10 hover:border-white/20 transition-all duration-500 hover:shadow-2xl hover:shadow-purple-500/20" data-project-id={project.id}>
          <!-- Category Badge -->
          <div class="absolute top-4 right-4 z-10">
            <span class="category-badge bg-gradient-to-r from-purple-500 to-pink-500 text-white text-xs font-semibold px-3 py-1 rounded-full">
              {project.category}
            </span>
          </div>

          <!-- Image Container -->
          <div class="card-image relative overflow-hidden rounded-xl mb-6 h-48 bg-gray-800">
            <img 
              src={project.image} 
              alt={project.title}
              class="w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-110"
              loading="lazy"
            />
            
            <!-- Hover Overlay -->
            <div class="image-overlay absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center">
              <div class="overlay-buttons flex gap-4">
                <a 
                  href={project.demoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="btn-demo flex items-center gap-2 bg-gradient-to-r from-blue-500 to-purple-600 text-white px-6 py-3 rounded-full font-medium hover:scale-105 transition-all duration-300 hover:shadow-lg"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                  Demo
                </a>
                <a 
                  href={project.codeUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="btn-code flex items-center gap-2 bg-gradient-to-r from-gray-700 to-gray-900 text-white px-6 py-3 rounded-full font-medium hover:scale-105 transition-all duration-300 hover:shadow-lg"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  Código
                </a>
              </div>
            </div>
          </div>

          <!-- Card Content -->
          <div class="card-content">
            <h3 class="project-title text-2xl font-bold text-white mb-3 group-hover:text-purple-300 transition-colors duration-300">
              {project.title}
            </h3>
            
            <p class="project-description text-gray-300 leading-relaxed mb-6 text-sm">
              {project.description}
            </p>

            <!-- Technologies -->
            <div class="technologies flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <span class="tech-tag bg-white/10 text-gray-300 text-xs font-medium px-3 py-1 rounded-full border border-white/10 hover:bg-white/20 hover:border-white/20 transition-all duration-300">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Configuración principal de GSAP
  gsap.set('.project-card', { opacity: 0, y: 100 });
  gsap.set('.section-title', { opacity: 0, y: -50 });
  gsap.set('.section-subtitle', { opacity: 0, y: 30 });

  // Timeline para la animación del header
  const headerTl = gsap.timeline({
    scrollTrigger: {
      trigger: '.section-header',
      start: 'top 80%',
      end: 'bottom 60%',
      toggleActions: 'play none none reverse'
    }
  });

  headerTl
    .to('.section-title', {
      duration: 1.2,
      opacity: 1,
      y: 0,
      ease: 'power3.out'
    })
    .to('.section-subtitle', {
      duration: 1,
      opacity: 1,
      y: 0,
      ease: 'power3.out'
    }, '-=0.8');

  // Animación escalonada para las tarjetas de proyectos
  gsap.to('.project-card', {
    duration: 1.2,
    opacity: 1,
    y: 0,
    stagger: {
      amount: 1.5,
      from: 'start'
    },
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '.projects-grid',
      start: 'top 85%',
      end: 'bottom 20%',
      toggleActions: 'play none none reverse'
    }
  });

  // Animaciones hover personalizadas con GSAP
  document.querySelectorAll('.project-card').forEach((card, index) => {
    const image = card.querySelector('img');
    const overlay = card.querySelector('.image-overlay');
    const buttons = card.querySelectorAll('.overlay-buttons a');
    const title = card.querySelector('.project-title');
    const techTags = card.querySelectorAll('.tech-tag');

    let hoverTl = gsap.timeline({ paused: true });

    // Timeline de hover
    hoverTl
      .to(card, {
        duration: 0.4,
        y: -10,
        scale: 1.02,
        boxShadow: '0 25px 50px rgba(139, 92, 246, 0.3)',
        ease: 'power2.out'
      })
      .to(overlay, {
        duration: 0.3,
        opacity: 1,
        ease: 'power2.inOut'
      }, '-=0.2')
      .from(buttons, {
        duration: 0.5,
        y: 30,
        opacity: 0,
        stagger: 0.1,
        ease: 'back.out(1.7)'
      }, '-=0.1');

    // Eventos de mouse
    card.addEventListener('mouseenter', () => {
      hoverTl.play();
      gsap.to(techTags, {
        duration: 0.3,
        backgroundColor: 'rgba(255, 255, 255, 0.2)',
        borderColor: 'rgba(255, 255, 255, 0.3)',
        stagger: 0.05,
        ease: 'power2.out'
      });
    });

    card.addEventListener('mouseleave', () => {
      hoverTl.reverse();
      gsap.to(techTags, {
        duration: 0.3,
        backgroundColor: 'rgba(255, 255, 255, 0.1)',
        borderColor: 'rgba(255, 255, 255, 0.1)',
        stagger: 0.05,
        ease: 'power2.out'
      });
    });

    // Animación de clic para los botones
    buttons.forEach(button => {
      button.addEventListener('click', (e) => {
        gsap.to(button, {
          duration: 0.1,
          scale: 0.95,
          yoyo: true,
          repeat: 1,
          ease: 'power2.inOut'
        });
      });
    });
  });

  // Animación de paralaje suave para el fondo
  gsap.to('.projects-section', {
    backgroundPosition: '50% 100%',
    ease: 'none',
    scrollTrigger: {
      trigger: '.projects-section',
      start: 'top bottom',
      end: 'bottom top',
      scrub: 1
    }
  });

  // Animación adicional para los badges de categoría
  gsap.from('.category-badge', {
    duration: 0.8,
    scale: 0,
    rotation: 180,
    stagger: 0.1,
    ease: 'back.out(1.7)',
    scrollTrigger: {
      trigger: '.projects-grid',
      start: 'top 80%'
    }
  });

  // Efecto de respiración sutil para las tarjetas
  gsap.to('.project-card', {
    duration: 4,
    rotationY: 2,
    rotationX: 1,
    yoyo: true,
    repeat: -1,
    ease: 'sine.inOut',
    stagger: {
      amount: 2,
      from: 'random'
    }
  });
</script>