---
const products = [
  {
    id: 1,
    name: "EcoTrack Dashboard",
    subtitle: "Sustainability Analytics Platform",
    description: "A comprehensive dashboard for tracking environmental impact metrics with real-time data visualization and reporting capabilities.",
    techStack: ["React", "Node.js", "D3.js", "PostgreSQL", "AWS"],
    image: "https://images.unsplash.com/photo-1551650975-87deedd944c3?w=500&h=400&fit=crop",
    category: "Web Application",
    status: "Live",
    demoUrl: "https://ecotrack-demo.com",
    codeUrl: "https://github.com/usuario/ecotrack",
    badge: "🌱 Environmental Impact",
    color: "from-green-500 to-sky-500"
  },
  {
    id: 2,
    name: "StreamSync",
    subtitle: "Real-time Collaboration Tool",
    description: "A collaborative workspace application enabling real-time document editing, video conferencing, and project management for distributed teams.",
    techStack: ["Vue.js", "Socket.io", "Express", "MongoDB", "WebRTC"],
    image: "https://images.unsplash.com/photo-1611224923853-80b023f02d71?w=500&h=400&fit=crop",
    category: "SaaS Platform",
    status: "Production",
    demoUrl: "https://streamsync-app.com",
    codeUrl: "https://github.com/usuario/streamsync",
    badge: "🚀 Featured Project",
    color: "from-blue-500 to-indigo-500"
  },
  {
    id: 3,
    name: "FitnessPal Mobile",
    subtitle: "AI-Powered Fitness Companion",
    description: "Mobile application with AI-driven workout recommendations, progress tracking, and social features for fitness enthusiasts.",
    techStack: ["React Native", "TensorFlow", "Firebase", "Redux", "Stripe"],
    image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=500&h=400&fit=crop",
    category: "Mobile App",
    status: "App Store",
    demoUrl: "https://apps.apple.com/fitnesspal",
    codeUrl: "https://github.com/usuario/fitnesspal",
    badge: "📱 Mobile Excellence",
    color: "from-blue-500 to-cyan-500"
  },
  {
    id: 4,
    name: "CryptoPortfolio Tracker",
    subtitle: "Cryptocurrency Management System",
    description: "Advanced portfolio management tool with real-time price tracking, automated alerts, and comprehensive analytics for crypto investors.",
    techStack: ["Next.js", "TypeScript", "Prisma", "Chart.js", "CoinGecko API"],
    image: "https://images.unsplash.com/photo-1639762681485-074b7f938ba0?w=500&h=400&fit=crop",
    category: "FinTech App",
    status: "Beta",
    demoUrl: "https://crypto-portfolio-demo.com",
    codeUrl: "https://github.com/usuario/crypto-portfolio",
    badge: "₿ Blockchain Innovation",
    color: "from-orange-500 to-red-500"
  },
  {
    id: 5,
    name: "SmartHome Hub",
    subtitle: "IoT Device Management Platform",
    description: "Centralized platform for managing smart home devices with automated routines, energy monitoring, and voice control integration.",
    techStack: ["Angular", "NestJS", "MQTT", "InfluxDB", "Raspberry Pi"],
    image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=500&h=400&fit=crop",
    category: "IoT Solution",
    status: "Production",
    demoUrl: "https://smarthome-hub.com",
    codeUrl: "https://github.com/usuario/smarthome-hub",
    badge: "🏠 Smart Technology",
    color: "from-cyan-500 to-blue-500"
  },
  {
    id: 6,
    name: "LearnFlow LMS",
    subtitle: "Educational Management System",
    description: "Complete learning management system with interactive courses, progress tracking, and gamification elements for online education.",
    techStack: ["Nuxt.js", "Laravel", "MySQL", "FFmpeg", "AWS S3"],
    image: "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=500&h=400&fit=crop",
    category: "EdTech Platform",
    status: "Live",
    demoUrl: "https://learnflow-demo.com",
    codeUrl: "https://github.com/usuario/learnflow",
    badge: "📚 Education Tech",
    color: "from-violet-500 to-blue-500"
  }
];
---

<section class="products-section py-24 bg-black min-h-screen relative overflow-hidden" id="products">
  <!-- Animated Background Elements -->
  <div class="absolute inset-0">
    <div class="floating-orb absolute top-1/4 left-1/6 w-72 h-72 bg-gradient-to-r from-blue-500/20 to-cyan-500/20 rounded-full blur-3xl"></div>
    <div class="floating-orb absolute top-3/4 right-1/6 w-96 h-96 bg-gradient-to-r from-blue-500/20 to-indigo-500/20 rounded-full blur-3xl"></div>
    <div class="floating-orb absolute top-1/2 left-1/2 w-64 h-64 bg-gradient-to-r from-sky-500/20 to-teal-500/20 rounded-full blur-3xl"></div>
  </div>

  <!-- Grid Pattern Background -->
  <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.1)_1px,transparent_1px)] [background-size:50px_50px] opacity-20"></div>

  <div class="container mx-auto px-6 lg:px-8 relative z-10">
    <!-- Hero Header -->
    <div class="section-header text-center mb-24">
      <div class="badge-container mb-6">
        <span class="inline-block bg-gradient-to-r from-blue-500/20 to-cyan-500/20 backdrop-blur-xl border border-blue-500/30 text-blue-300 px-6 py-3 rounded-full text-sm font-semibold tracking-wide">
          💻 PRODUCTS I'VE BUILT
        </span>
      </div>
      
      <h1 class="section-title text-5xl md:text-7xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-blue-200 to-cyan-200 mb-8 leading-tight">
        My Digital
        <span class="block bg-gradient-to-r from-blue-400 via-cyan-400 to-orange-400 bg-clip-text text-transparent">
          Products
        </span>
      </h1>
      
      <p class="section-subtitle text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto leading-relaxed font-light">
        A showcase of innovative applications and platforms I've developed, each solving real-world problems with modern technology and thoughtful user experience
      </p>

      <!-- Achievement Stats -->
      <div class="stats-container flex justify-center gap-12 mt-12">
        <div class="stat-item text-center">
          <div class="stat-number text-3xl font-bold text-white mb-2">6</div>
          <div class="stat-label text-gray-400 text-sm">Products Launched</div>
        </div>
        <div class="stat-item text-center">
          <div class="stat-number text-3xl font-bold text-white mb-2">50K+</div>
          <div class="stat-label text-gray-400 text-sm">Active Users</div>
        </div>
        <div class="stat-item text-center">
          <div class="stat-number text-3xl font-bold text-white mb-2">15+</div>
          <div class="stat-label text-gray-400 text-sm">Technologies Used</div>
        </div>
      </div>
    </div>

    <!-- Products Grid -->
    <div class="products-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 lg:gap-12 mb-24">
      {products.map((product, index) => (
        <div class="product-card group relative bg-white/[0.02] backdrop-blur-2xl rounded-3xl p-8 border border-white/10 transition-all duration-700 hover:border-white/30 hover:bg-white/[0.05]" data-product-id={product.id}>
          
          <!-- Status Badge -->
          <div class="status-badge absolute -top-4 -right-4 z-20">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-r from-green-400 to-sky-500 rounded-full blur-sm"></div>
              <span class="relative bg-gradient-to-r from-green-400 to-sky-500 text-black text-xs font-bold px-4 py-2 rounded-full flex items-center">
                ✅ {product.status}
              </span>
            </div>
          </div>

          <!-- Custom Badge -->
          <div class="absolute top-6 left-6 z-10">
            <span class="category-badge text-white text-xs font-semibold px-3 py-2 rounded-full border border-white/20 backdrop-blur-xl bg-white/10">
              {product.badge}
            </span>
          </div>

          <!-- Image Container -->
          <div class="product-image relative overflow-hidden rounded-2xl mb-8 h-56 group-hover:shadow-2xl transition-all duration-700">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10"></div>
            <img 
              src={product.image} 
              alt={product.name}
              class="w-full h-full object-cover transition-all duration-1000 ease-out group-hover:scale-125 group-hover:rotate-2"
              loading="lazy"
            />
            
            <!-- Floating Action Buttons -->
            <div class="image-overlay absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 z-20">
              <div class="flex gap-3">
                <a 
                  href={product.demoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="cta-button bg-white text-black px-6 py-3 rounded-full font-bold hover:scale-110 transition-all duration-300 shadow-2xl flex items-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                  Live Demo
                </a>
                <a 
                  href={product.codeUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="cta-button bg-gray-800 text-white px-6 py-3 rounded-full font-bold hover:scale-110 transition-all duration-300 shadow-2xl flex items-center gap-2"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  Code
                </a>
              </div>
            </div>

            <!-- Category Label -->
            <div class="absolute bottom-4 left-4 z-20">
              <span class={`category-label bg-gradient-to-r ${product.color} text-white text-sm font-semibold px-4 py-2 rounded-full`}>
                {product.category}
              </span>
            </div>
          </div>

          <!-- Product Content -->
          <div class="product-content">
            <!-- Title & Subtitle -->
            <div class="title-section mb-6">
              <h3 class="product-title text-2xl font-bold text-white mb-2 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-blue-400 group-hover:to-cyan-400 transition-all duration-300">
                {product.name}
              </h3>
              <p class="product-subtitle text-blue-300 font-medium text-sm tracking-wide uppercase">
                {product.subtitle}
              </p>
            </div>
            
            <!-- Description -->
            <p class="product-description text-gray-400 leading-relaxed mb-8 text-sm">
              {product.description}
            </p>

            <!-- Tech Stack -->
            <div class="tech-stack-section mb-8">
              <h4 class="text-white font-semibold mb-4 text-sm tracking-wide uppercase">Tech Stack:</h4>
              <div class="flex flex-wrap gap-2">
                {product.techStack.map((tech, techIndex) => (
                  <span class="tech-item bg-gradient-to-r from-gray-700 to-gray-800 text-gray-200 text-xs font-medium px-3 py-2 rounded-full border border-gray-600 hover:border-gray-400 transition-all duration-300 group/tech">
                    <span class="group-hover/tech:text-white transition-colors duration-300">{tech}</span>
                  </span>
                ))}
              </div>
            </div>

            <!-- Project Metrics -->
            <div class="metrics-section mb-6">
              <div class="grid grid-cols-2 gap-4 text-center">
                <div class="metric-item bg-white/5 rounded-xl p-3">
                  <div class="metric-value text-lg font-bold text-white">Live</div>
                  <div class="metric-label text-xs text-gray-400">Status</div>
                </div>
                <div class="metric-item bg-white/5 rounded-xl p-3">
                  <div class="metric-value text-lg font-bold text-white">{product.techStack.length}</div>
                  <div class="metric-label text-xs text-gray-400">Technologies</div>
                </div>
              </div>
            </div>

            <!-- Action Button -->
            <div class="action-buttons">
              <a 
                href={product.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`btn-primary w-full bg-gradient-to-r ${product.color} text-white py-4 px-6 rounded-2xl font-bold text-lg hover:scale-105 hover:shadow-2xl transition-all duration-300 group/btn text-center block`}
              >
                <span class="group-hover/btn:scale-110 inline-block transition-transform duration-300">
                  Explore Product
                </span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Portfolio CTA -->
    <div class="cta-section">
      <div class="cta-container relative bg-gradient-to-br from-blue-900/30 via-cyan-900/20 to-blue-900/30 backdrop-blur-2xl rounded-3xl p-12 lg:p-16 border border-white/20 text-center">
        <!-- Decorative Elements -->
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_50%,rgba(139,92,246,0.1),transparent_50%)] rounded-3xl"></div>
        
        <div class="relative z-10">
          <div class="mb-8">
            <span class="inline-block bg-gradient-to-r from-blue-500/20 to-cyan-500/20 backdrop-blur-xl border border-blue-500/30 text-blue-300 px-6 py-3 rounded-full text-sm font-semibold tracking-wide mb-6">
              🚀 MORE COMING SOON
            </span>
          </div>
          
          <h3 class="text-4xl lg:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-300 mb-6">
            Interested in My 
            <span class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Work?</span>
          </h3>
          
          <p class="text-gray-300 text-xl leading-relaxed mb-10 max-w-3xl mx-auto">
            These products represent my journey in building scalable, user-focused applications. Check out my GitHub for more projects and detailed documentation.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="https://github.com/usuario" 
              target="_blank"
              rel="noopener noreferrer"
              class="btn-custom bg-gradient-to-r from-white to-gray-100 text-black px-10 py-5 rounded-2xl font-bold text-lg hover:scale-105 hover:shadow-2xl transition-all duration-300 group"
            >
              <span class="group-hover:scale-110 inline-block transition-transform duration-300">
                View All Projects
              </span>
            </a>
            <a 
              href="#contact"
              class="btn-outline border-2 border-white/30 hover:border-white/50 text-white px-10 py-5 rounded-2xl font-bold text-lg hover:bg-white/5 transition-all duration-300"
            >
              Get In Touch
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Initial states
  gsap.set('.product-card', { opacity: 0, y: 100, scale: 0.8, rotationY: 15 });
  gsap.set('.section-title', { opacity: 0, y: -100 });
  gsap.set('.section-subtitle', { opacity: 0, y: 50 });
  gsap.set('.badge-container', { opacity: 0, scale: 0 });
  gsap.set('.stats-container', { opacity: 0, y: 30 });
  gsap.set('.cta-section', { opacity: 0, y: 100 });

  // Floating orbs animation
  gsap.to('.floating-orb', {
    duration: 20,
    rotation: 360,
    ease: 'none',
    repeat: -1
  });

  gsap.to('.floating-orb:nth-child(1)', {
    duration: 15,
    x: 100,
    y: 50,
    yoyo: true,
    repeat: -1,
    ease: 'sine.inOut'
  });

  gsap.to('.floating-orb:nth-child(2)', {
    duration: 18,
    x: -80,
    y: -60,
    yoyo: true,
    repeat: -1,
    ease: 'sine.inOut'
  });

  // Header animations
  const headerTl = gsap.timeline({
    scrollTrigger: {
      trigger: '.section-header',
      start: 'top 80%',
      toggleActions: 'play none none reverse'
    }
  });

  headerTl
    .to('.badge-container', {
      duration: 0.8,
      opacity: 1,
      scale: 1,
      ease: 'back.out(1.7)'
    })
    .to('.section-title', {
      duration: 1.5,
      opacity: 1,
      y: 0,
      ease: 'power3.out'
    }, '-=0.5')
    .to('.section-subtitle', {
      duration: 1.2,
      opacity: 1,
      y: 0,
      ease: 'power3.out'
    }, '-=1')
    .to('.stats-container', {
      duration: 1,
      opacity: 1,
      y: 0,
      ease: 'power3.out'
    }, '-=0.5');

  // Product cards stagger animation
  gsap.to('.product-card', {
    duration: 1.8,
    opacity: 1,
    y: 0,
    scale: 1,
    rotationY: 0,
    stagger: {
      amount: 2,
      from: 'start'
    },
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '.products-grid',
      start: 'top 80%',
      toggleActions: 'play none none reverse'
    }
  });

  // CTA section animation
  gsap.to('.cta-section', {
    duration: 1.5,
    opacity: 1,
    y: 0,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '.cta-section',
      start: 'top 85%',
      toggleActions: 'play none none reverse'
    }
  });

  // Enhanced hover interactions
  document.querySelectorAll('.product-card').forEach((card, index) => {
    const overlay = card.querySelector('.image-overlay');
    const ctaButtons = card.querySelectorAll('.cta-button');
    const techItems = card.querySelectorAll('.tech-item');

    let hoverTl = gsap.timeline({ paused: true });

    hoverTl
      .to(card, {
        duration: 0.6,
        y: -20,
        scale: 1.05,
        rotationY: 5,
        boxShadow: '0 40px 80px rgba(139, 92, 246, 0.3)',
        ease: 'power2.out'
      })
      .to(overlay, {
        duration: 0.4,
        opacity: 1,
        ease: 'power2.out'
      }, '-=0.3')
      .from(ctaButtons, {
        duration: 0.6,
        scale: 0,
        rotation: 180,
        stagger: 0.1,
        ease: 'back.out(1.7)'
      }, '-=0.2');

    card.addEventListener('mouseenter', () => {
      hoverTl.play();
      
      gsap.to(techItems, {
        duration: 0.3,
        borderColor: 'rgba(156, 163, 175, 0.6)',
        stagger: 0.05,
        ease: 'power2.out'
      });
    });

    card.addEventListener('mouseleave', () => {
      hoverTl.reverse();
      
      gsap.to(techItems, {
        duration: 0.3,
        borderColor: 'rgba(75, 85, 99, 1)',
        ease: 'power2.out'
      });
    });
  });

  // Status badges animation
  gsap.from('.status-badge', {
    duration: 1.2,
    scale: 0,
    rotation: 360,
    ease: 'back.out(1.7)',
    stagger: 0.2,
    scrollTrigger: {
      trigger: '.products-grid',
      start: 'top 75%'
    }
  });

  // Button click feedback
  document.querySelectorAll('button, a[class*="btn"]').forEach(button => {
    button.addEventListener('click', () => {
      gsap.to(button, {
        duration: 0.15,
        scale: 0.95,
        yoyo: true,
        repeat: 1,
        ease: 'power2.inOut'
      });
    });
  });
</script>