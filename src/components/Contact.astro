---
import Text from './Text.astro';
import { contactEmail, contactPhone } from '../lib/contact';
// Optional public URL. No secret or credential belongs in a PUBLIC_ environment variable.
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
---
<section id="contact" class="contact page-width" aria-labelledby="contact-title">
  <div class="contact-copy" data-reveal="heading">
    <p class="section-label"><Text en="START WITH AN IDEA" es="EMPECEMOS CON UNA IDEA" /></p>
    <h2 id="contact-title"><Text en="Have something in mind? Let’s make it real." es="¿Tienes algo en mente? Hagámoslo realidad." /></h2>
    <p class="contact-intro"><Text en="A short note is enough to begin." es="Una nota breve es suficiente para empezar." /></p>
    <div class="direct-contact-list">
      <a class="direct-contact-item" href={`mailto:${contactEmail}`}>
        <span>{contactEmail}</span>
        <span class="contact-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="direct-contact-item" href={`tel:${contactPhone.replace(/\s+/g, '')}`}>
        <span>{contactPhone}</span>
        <span class="contact-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <form id="contact-form" class="intake" data-reveal="copy" data-endpoint={endpoint} action={`mailto:${contactEmail}`} method="post" enctype="text/plain">
    <div class="intake-heading">
      <h3><Text en="Tell me about it" es="Cuéntame sobre tu idea" /></h3>
      <span>05</span>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="contact-name"><Text en="Name" es="Nombre" /><span aria-hidden="true"> *</span></label>
        <input id="contact-name" name="name" autocomplete="name" required maxlength="120" placeholder="Alex" />
      </div>
      <div class="field">
        <label for="contact-email">Email<span aria-hidden="true"> *</span></label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@company.com" />
      </div>
    </div>

    <div class="field">
      <label for="contact-phone"><Text en="Phone number" es="Número de teléfono" /><span aria-hidden="true"> *</span></label>
      <input id="contact-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="40" placeholder="+593 99 000 0000" />
    </div>

    <div class="field">
      <label for="project-name"><Text en="Project name" es="Nombre del proyecto" /><span aria-hidden="true"> *</span></label>
      <input id="project-name" name="projectName" required maxlength="160" placeholder="Project / Organization" />
    </div>

    <div class="field">
      <label for="project-proposal"><Text en="Project proposal" es="Propuesta del proyecto" /><span aria-hidden="true"> *</span></label>
      <textarea id="project-proposal" name="proposal" rows="5" required maxlength="2400" placeholder="What would you like to build?"></textarea>
    </div>

    <button class="button-primary submit" type="submit"><Text en="Send project idea" es="Enviar idea de proyecto" /><span aria-hidden="true">↗</span></button>
    {!endpoint && <p class="delivery-note"><Text en="This prepares an email draft for you to review and send." es="Se preparará un borrador de correo para que lo revises y envíes." /></p>}
    <p class="form-status" data-form-status role="status" tabindex="-1" hidden></p>
    <div class="contact-fallback" data-contact-fallback hidden>
      <div class="fallback-actions">
        <a class="text-link" data-open-draft href={`mailto:${contactEmail}`}><Text en="Open email draft ↗" es="Abrir borrador ↗" /></a>
        <button type="button" data-copy-inquiry><Text en="Copy inquiry" es="Copiar consulta" /></button>
      </div>
      <textarea class="fallback-text" data-fallback-text readonly rows="8" aria-label="Prepared inquiry" hidden></textarea>
    </div>
    <noscript><p class="delivery-note"><Text en="Submitting opens your email application. You can also email me directly." es="Al enviar se abrirá tu aplicación de correo. También puedes escribirme directamente." /></p></noscript>
  </form>
</section>
<script src="./contact-form.ts"></script>
<style>
  .contact { display: grid; grid-template-columns: .82fr 1.18fr; gap: clamp(52px, 8vw, 120px); padding-block: var(--space-section); align-items: stretch; }
  .contact-copy { min-height: 640px; display: flex; flex-direction: column; }
  .section-label { margin-bottom: 28px; }
  h2 { max-width: 10ch; font-size: clamp(3rem, 5.1vw, 5rem); line-height: 1.04; font-weight: 550; letter-spacing: -.04em; }
  .contact-intro { color: var(--muted); font-size: .9375rem; margin-top: 28px; }
  .direct-contact-list { margin-top: auto; border-top: 1px solid var(--line); }
  .direct-contact-item { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding-block: 20px; border-bottom: 1px solid var(--line); font-size: .8125rem; transition: color var(--motion-fast); }
  .direct-contact-item:hover { color: var(--blue); }
  .contact-arrow { font-size: .875rem; color: var(--muted); transition: transform var(--motion-fast) var(--ease-out), color var(--motion-fast); }
  .direct-contact-item:hover .contact-arrow { color: var(--blue); transform: translate(2px, -2px); }

  .intake { border-top: 1px solid var(--ink); padding-top: 24px; display: grid; align-content: start; gap: 26px; }
  .intake-heading { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
  .intake-heading h3 { font-size: 1.125rem; font-weight: 550; }
  .intake-heading > span { color: var(--muted); font-size: .6875rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field { min-width: 0; }
  .field label { display: block; font-size: .75rem; font-weight: 550; margin-bottom: 9px; }
  input, textarea { width: 100%; background: var(--soft); border: 1px solid var(--field-line); border-radius: var(--radius-control); padding: 14px 15px; color: var(--ink); font-size: .8125rem; transition: border-color var(--motion-fast), background-color var(--motion-fast), color var(--motion-fast); }
  input:focus, textarea:focus { border-color: var(--blue); background: var(--paper); outline: 2px solid var(--selected); outline-offset: 1px; }
  input::placeholder, textarea::placeholder { color: var(--muted); }
  textarea { resize: vertical; min-height: 150px; }
  .submit { width: 100%; justify-content: space-between; margin-top: 2px; }
  .delivery-note { color: var(--muted); font-size: .6875rem; text-align: center; margin-top: -12px; }
  .form-status { padding: 16px; border: 1px solid var(--focus); background: var(--selected); font-size: .8125rem; border-radius: var(--radius-control); color: var(--selected-text); }
  .form-status[data-state="error"] { color: var(--error); background: var(--error-bg); border-color: color-mix(in srgb, var(--error) 38%, var(--paper)); }
  .fallback-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
  .fallback-actions a { color: var(--blue); font-size: .75rem; }
  .fallback-actions button { border: 1px solid var(--field-line); border-radius: var(--radius-control); padding: 10px 14px; background: var(--paper); color: var(--ink); font-size: .75rem; }
  .fallback-text { margin-top: 16px; }

  @media(max-width: 1000px) {
    .contact { grid-template-columns: 1fr; }
    .contact-copy { min-height: 440px; }
    h2 { max-width: 13ch; }
    .direct-contact-list { margin-top: 48px; }
    input, textarea { font-size: 1rem; }
  }
  @media(max-width: 520px) {
    .contact-copy { min-height: 390px; }
    .field-row { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
