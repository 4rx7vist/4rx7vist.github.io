---

---

<section
  id="contact"
  class="bg-[#08080a] pt-16 pb-32 px-6 sm:px-12 flex items-center justify-center relative overflow-hidden"
>
  <!-- Background glowing blur -->
  <div class="absolute bottom-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-purple-900/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-3xl w-full relative z-10">
    <!-- Header -->
    <div class="text-left mb-16">
      <span class="text-xs font-bold tracking-[0.3em] text-purple-400 uppercase mb-3 block">
        <span class="lang-en-text">Get In Touch</span>
        <span class="lang-es-text">Contáctanos</span>
      </span>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-white mb-6 leading-tight tracking-tight">
        <span class="lang-en-text">Let's <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-400 to-blue-400">build your solution</span>.</span>
        <span class="lang-es-text">Construyamos <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-400 to-blue-400">tu solución</span>.</span>
      </h2>
      <p class="text-gray-400 text-lg font-light leading-relaxed">
        <span class="lang-en-text">Have a system to automate, a payment platform to integrate, or a custom product to build? Tell us about it.</span>
        <span class="lang-es-text">¿Tienes un sistema que automatizar, una pasarela de pago que integrar o un producto personalizado que crear? Cuéntanos.</span>
      </p>
    </div>

    <!-- Contact Form Wrapper -->
    <div
      class="bg-[#0e0e12]/40 backdrop-blur-xl border border-white/5 rounded-[2rem] p-8 md:p-14 shadow-2xl"
    >
      <form id="contact-form" class="space-y-10">
        <!-- Name Field -->
        <div class="group">
          <div class="relative">
            <input
              type="text"
              id="name"
              name="name"
              required
              class="peer w-full bg-transparent border-b border-white/10 focus:border-purple-400 py-4 px-0 text-white placeholder-transparent outline-none transition-all duration-300"
              placeholder="Your name or company"
            />
            <label
              for="name"
              class="absolute left-0 -top-6 text-gray-500 text-sm transition-all duration-300 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-500 peer-placeholder-shown:top-4 peer-focus:-top-6 peer-focus:text-xs peer-focus:text-purple-400 uppercase font-bold tracking-wider"
            >
              <span class="lang-en-text">What is your name / company name?</span>
              <span class="lang-es-text">¿Cuál es tu nombre o empresa?</span>
            </label>
          </div>
        </div>

        <!-- Email Field -->
        <div class="group">
          <div class="relative">
            <input
              type="email"
              id="email"
              name="email"
              required
              class="peer w-full bg-transparent border-b border-white/10 focus:border-purple-400 py-4 px-0 text-white placeholder-transparent outline-none transition-all duration-300"
              placeholder="your@company.com"
            />
            <label
              for="email"
              class="absolute left-0 -top-6 text-gray-500 text-sm transition-all duration-300 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-500 peer-placeholder-shown:top-4 peer-focus:-top-6 peer-focus:text-xs peer-focus:text-purple-400 uppercase font-bold tracking-wider"
            >
              <span class="lang-en-text">Your corporate or primary email address</span>
              <span class="lang-es-text">Tu correo corporativo o principal</span>
            </label>
          </div>
        </div>

        <!-- Subject Field -->
        <div class="group">
          <div class="relative">
            <input
              type="text"
              id="subject"
              name="subject"
              class="peer w-full bg-transparent border-b border-white/10 focus:border-purple-400 py-4 px-0 text-white placeholder-transparent outline-none transition-all duration-300"
              placeholder="Solution needed (e.g. Payments, CRM, SaaS, ERP)"
            />
            <label
              for="subject"
              class="absolute left-0 -top-6 text-gray-500 text-sm transition-all duration-300 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-500 peer-placeholder-shown:top-4 peer-focus:-top-6 peer-focus:text-xs peer-focus:text-purple-400 uppercase font-bold tracking-wider"
            >
              <span class="lang-en-text">What solution are you interested in?</span>
              <span class="lang-es-text">¿En qué solución estás interesado?</span>
            </label>
          </div>
        </div>

        <!-- Message Field -->
        <div class="group">
          <div class="relative">
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="peer w-full bg-transparent border-b border-white/10 focus:border-purple-400 py-4 px-0 text-white placeholder-transparent outline-none resize-none transition-all duration-300"
              placeholder="Describe your challenge..."></textarea>
            <label
              for="message"
              class="absolute left-0 -top-6 text-gray-500 text-sm transition-all duration-300 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-500 peer-placeholder-shown:top-4 peer-focus:-top-6 peer-focus:text-xs peer-focus:text-purple-400 uppercase font-bold tracking-wider"
            >
              <span class="lang-en-text">Tell us about your project scope, goals, or timeline...</span>
              <span class="lang-es-text">Cuéntanos sobre el alcance, objetivos o plazo de tu proyecto...</span>
            </label>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-6">
          <button
            type="submit"
            id="submit-btn"
            class="magnetic-target w-full bg-white hover:bg-purple-500 text-black hover:text-white font-bold py-4 px-8 rounded-full shadow-lg shadow-white/5 hover:shadow-purple-500/30 transition-all duration-300 text-center text-sm uppercase tracking-wider"
          >
            <span id="btn-text" class="relative z-10">
              <span class="lang-en-text">Send Inquiry</span>
              <span class="lang-es-text">Enviar Consulta</span>
            </span>
          </button>
        </div>
      </form>

      <!-- Status Message -->
      <div id="form-status" class="mt-6 text-center hidden">
        <div id="status-content" class="text-sm"></div>
      </div>
    </div>

    <!-- Quick Contact Options -->
    <div class="mt-16 text-center">
      <p class="text-gray-500 text-xs font-bold tracking-widest uppercase mb-6">
        <span class="lang-en-text">Or contact our team directly</span>
        <span class="lang-es-text">O contáctanos directamente</span>
      </p>
      <div class="flex justify-center gap-8">
        <a
          href="mailto:alexis95@hotmail.com"
          class="magnetic-target group flex items-center gap-3 text-gray-400 hover:text-purple-400 transition-colors duration-300 px-4 py-2 border border-white/5 hover:border-purple-500/30 rounded-full bg-white/[0.01]"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
          </svg>
          <span class="text-xs font-bold uppercase tracking-wider">Email</span>
        </a>

        <a
          href="https://linkedin.com/in/alexis-sotomayor"
          target="_blank"
          rel="noopener noreferrer"
          class="magnetic-target group flex items-center gap-3 text-gray-400 hover:text-blue-400 transition-colors duration-300 px-4 py-2 border border-white/5 hover:border-blue-500/30 rounded-full bg-white/[0.01]"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-xs font-bold uppercase tracking-wider">LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // Form entrance timeline
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#contact",
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
    });

    tl.fromTo(
      "#contact .text-left",
      {
        opacity: 0,
        y: 40,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
      }
    )
    .fromTo(
      "#contact .bg-\\[\\#0e0e12\\]\\/40",
      {
        opacity: 0,
        y: 60,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
      },
      "-=0.5"
    )
    .fromTo(
      "#contact .group",
      {
        opacity: 0,
        y: 20,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
        stagger: 0.1,
        ease: "power2.out",
      },
      "-=0.4"
    )
    .fromTo(
      "#submit-btn",
      {
        opacity: 0,
        y: 20,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "back.out(1.7)",
      },
      "-=0.3"
    )
    .fromTo(
      "#contact .mt-16",
      {
        opacity: 0,
        y: 30,
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power2.out",
      },
      "-=0.2"
    );

    // Form submission
    const form = document.getElementById("contact-form");
    const submitBtn = document.getElementById("submit-btn");
    const btnText = document.getElementById("btn-text");
    const formStatus = document.getElementById("form-status");
    const statusContent = document.getElementById("status-content");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        name: formData.get("name"),
        email: formData.get("email"),
        subject: formData.get("subject") || "Contact Form",
        message: formData.get("message"),
      };

      submitBtn.disabled = true;
      gsap.to(btnText, {
        scale: 0.95,
        duration: 0.2,
        onComplete: () => {
          btnText.textContent = "Sending...";
          gsap.to(btnText, { scale: 1, duration: 0.2 });
        },
      });

      try {
        // Simulate API call
        await new Promise((resolve) => setTimeout(resolve, 1500));

        gsap.to(submitBtn, {
          scale: 0.98,
          duration: 0.1,
          yoyo: true,
          repeat: 1,
        });

        showStatus(
          "Inquiry sent successfully! Our team will get back to you soon. ✅",
          "success"
        );

        // Reset fields
        form.reset();

        setTimeout(() => {
          gsap.to(btnText, {
            scale: 0.95,
            duration: 0.2,
            onComplete: () => {
              btnText.textContent = "Send Inquiry";
              submitBtn.disabled = false;
              gsap.to(btnText, { scale: 1, duration: 0.2 });
            },
          });
        }, 2000);
      } catch (error) {
        showStatus("Failed to send inquiry. Please try again. ❌", "error");
        gsap.to(btnText, {
          scale: 0.95,
          duration: 0.2,
          onComplete: () => {
            btnText.textContent = "Send Inquiry";
            submitBtn.disabled = false;
            gsap.to(btnText, { scale: 1, duration: 0.2 });
          },
        });
      }
    });

    function showStatus(message, type) {
      statusContent.textContent = message;
      statusContent.className = `text-sm font-semibold ${type === "success" ? "text-green-400" : "text-red-400"}`;

      formStatus.classList.remove("hidden");
      gsap.fromTo(
        formStatus,
        { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 0.3, ease: "power2.out" }
      );

      setTimeout(() => {
        gsap.to(formStatus, {
          opacity: 0,
          y: -15,
          duration: 0.3,
          onComplete: () => {
            formStatus.classList.add("hidden");
          },
        });
      }, 5000);
    }
  });

  window.addEventListener("resize", () => {
    ScrollTrigger.refresh();
  });
</script>

<style>
  .group:focus-within label {
    color: #c084fc;
  }
</style>

