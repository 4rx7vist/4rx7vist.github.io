<nav
  class="bg-black text-white px-4 sm:px-6 py-4 flex justify-between items-center shadow-md"
>
  <div class="text-lg sm:text-xl font-bold flex flex-col leading-tight">
    <span class="text-xs sm:text-sm font-normal text-purple-400">Tech Solutions Studio</span>
    <span class="text-sm sm:text-base">Port Vault</span>
  </div>

  <div class="flex-1 flex justify-center">
    <span
      id="pseudo"
      class="text-base sm:text-lg font-mono font-semibold tracking-widest select-none"
    >
      <span class="text-content"></span><span class="cursor">|</span>
    </span>
  </div>

  <div class="flex items-center gap-3">
    <a
      href="#contact"
      class="bg-black text-white px-4 py-2 rounded-md border border-transparent hover:bg-gray-600 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500"
      aria-label="Contact"
    >
      Contact
    </a>
  </div>
</nav>

<style>
  .cursor {
    animation: blink 0.7s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  // Importar GSAP y TextPlugin
  import { gsap } from "gsap";
  import { TextPlugin } from "gsap/TextPlugin";
  
  // Registrar el plugin
  gsap.registerPlugin(TextPlugin);
  
  // Función que ejecuta la animación
  function runAnimation() {

    // Seleccionar el elemento
    const textElement = document.querySelector("#pseudo .text-content");
    
    // Verificar que el elemento existe
    if (!textElement) {
      // Si no existe, reintentamos después
      setTimeout(runAnimation, 500);
      return;
    }
    
    
    // Texto que queremos animar
    const text = "4rx7vist";
    
    // Configurar la animación
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 1 });
    
    // Asegurarse de que empieza vacío
    gsap.set(textElement, { text: "" });
    
    // Animación de escritura
    tl.to(textElement, {
      text: text,
      duration: text.length * 0.15,
      ease: "none",
      onStart: () => {},
      onComplete: () => {}
    })
    .to({}, { duration: 1 }) // Pausa
    .to(textElement, {
      text: "",
      duration: text.length * 0.08,
      ease: "none",
      onStart: () => {},
      onComplete: () => {}
    })
    .to({}, { duration: 0.5 }); // Pausa
    
  }
  
  // Ejecutar cuando el DOM esté listo
  document.addEventListener("DOMContentLoaded", () => {
    runAnimation();
  });
  
  // Si el documento ya está cargado, ejecutar inmediatamente
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(runAnimation, 100);
  }
</script>