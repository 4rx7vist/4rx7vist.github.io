---
const skills = [
  { key: "css", name: "css3", icon: "icons/css.svg" },
  { key: "js", name: "javascript", icon: "icons/javascript.svg" },
  { key: "react", name: "reactjs", icon: "icons/react.svg" },
  { key: "node", name: "nodejs", icon: "icons/nodeJS.svg" },
  { key: "sql", name: "sql-database", icon: "icons/postgresSQL.svg" },
  { key: "aws", name: "aws", icon: "icons/aws.svg" },
  { key: "firebase", name: "firebase", icon: "icons/firebase.svg" },
  { key: "python", name: "python", icon: "icons/python.svg" },
  { key: "docker", name: "docker", icon: "icons/docker.svg" },
  { key: "git", name: "git", icon: "icons/git.svg" },
  { key: "linux", name: "linux", icon: "icons/linux.svg" },
  { key: "bash", name: "bash", icon: "icons/bash.svg" },
];
---

<section id="skills" class="py-12 bg-black">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-10 relative">
      <h2 class="text-white text-3xl md:text-4xl font-bold tracking-tight mb-4">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-cyan-300">
          Technologies I currently use
        </span>
      </h2>
      <div class="h-0.5 w-24 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full opacity-80"></div>
      <p class="text-gray-400 text-sm md:text-base mt-2 mb-3 tracking-wide">
        These are the technologies I'm actively using to build robust systems
      </p>
    </div>

    <ul class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-6 place-items-center">
      {
        skills.map((s) => (
          <li
            class="skill-card group w-full max-w-[88px] flex flex-col items-center gap-2 select-none transition-transform duration-200 ease-out group-hover:-translate-y-1 group-hover:scale-105"
            data-key={s.key}
            aria-label={s.name}
          >
            <div class="icon-wrap w-20 h-20 rounded-full flex items-center justify-center bg-transparent transition-transform transform-gpu will-change-transform">
              <img
                src={s.icon}
                alt={s.name}
                class="skill-icon w-10 h-10 filter grayscale opacity-60 transition-all duration-150 group-hover:grayscale-0 group-hover:opacity-100"
              />
            </div>
            <span class="skill-name text-xs text-gray-400 tracking-wide transition-colors duration-150 group-hover:text-[#7fb0ff]">
              {s.name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script type="module">
  import { gsap } from "gsap";

  if (typeof window !== "undefined") {
    function initSkills() {
      const cards = Array.from(document.querySelectorAll(".skill-card"));
      const floatTweens = new Map();

      function createFloat(card, delay = 0) {
        if (floatTweens.has(card)) {
          const prev = floatTweens.get(card);
          try { prev.kill(); } catch (e) {}
        }
        const dur = 3 + Math.random() * 3;
        const y = 6 + Math.random() * 8;
        const tween = gsap.to(card, {
          y: `+=${y}`,
          duration: dur,
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          delay,
        });
        floatTweens.set(card, tween);
        return tween;
      }

      // Crear flotado inicial
      cards.forEach((card, i) => createFloat(card, (i % 6) * 0.08));

      // Color elegido para texto al hover (coincide con el azul tenue del filtro)
      const HOVER_COLOR = "#7FB0FF";
      const BASE_COLOR = "#9CA3AF"; // tailwind gray-400

      // Hover: solo visual (azul tenue) y tilt; no se declara como clickeable
      cards.forEach((card) => {
        const icon = card.querySelector(".skill-icon");
        const label = card.querySelector(".skill-name");

        const enter = () => {
          const t = floatTweens.get(card);
          if (t) t.pause();

          gsap.to(card, { scale: 1.06, y: -8, duration: 0.18, ease: "power2.out" });
          gsap.to(icon, {
            filter: "grayscale(0%) sepia(0.25) saturate(2.4) hue-rotate(185deg) brightness(0.95)",
            opacity: 1,
            duration: 0.18,
            ease: "power2.out",
          });
          // animar color del label para que coincida
          if (label) gsap.to(label, { color: HOVER_COLOR, duration: 0.18, ease: "power2.out" });
        };

        const leave = () => {
          gsap.to(card, {
            scale: 1,
            rotateX: 0,
            rotateY: 0,
            y: 0,
            duration: 0.35,
            ease: "power3.out",
            onComplete: () => {
              createFloat(card);
            },
          });

          gsap.to(icon, {
            filter: "grayscale(100%)",
            opacity: 0.6,
            duration: 0.25,
            ease: "power3.out",
          });

          if (label) gsap.to(label, { color: BASE_COLOR, duration: 0.25, ease: "power3.out" });
        };

        const move = (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width;
          const py = (e.clientY - rect.top) / rect.height;
          const rotY = (px - 0.5) * 10;
          const rotX = (0.5 - py) * 6;
          gsap.to(card, { rotateY: rotY, rotateX: rotX, duration: 0.12, ease: "power1.out" });
        };

        // Registrar pointer events + mouse como respaldo
        card.addEventListener("pointerenter", enter);
        card.addEventListener("pointerleave", leave);
        card.addEventListener("pointermove", move);

        card.addEventListener("mouseenter", enter);
        card.addEventListener("mouseleave", leave);
        card.addEventListener("mousemove", move);
      });
    }

    if (document.readyState === "loading") {
      window.addEventListener("DOMContentLoaded", initSkills);
    } else {
      initSkills();
    }
  }
</script>
