---
const skills = [
  { key: "Nextjs", name: "Nextjs", icon: "icons/next.svg" },
  { key: "react", name: "React", icon: "icons/react.svg" },
  { key: "TypeScript", name: "TypeScript", icon: "icons/typescript.svg" },
  { key: "node", name: "NodeJS", icon: "icons/nodeJS.svg" },
  { key: "Java", name: "Java", icon: "icons/java.svg" },
  { key: "python", name: "Python", icon: "icons/python.svg" },
  { key: "PostgreSQL", name: "PostgreSQL", icon: "icons/postgresSQL.svg" },
  { key: "SQL-server", name: "SQL Server", icon: "icons/SQL-server.svg" },
  { key: "docker", name: "Docker", icon: "icons/docker.svg" },
  { key: "git", name: "Git", icon: "icons/git.svg" },
  { key: "linux", name: "Linux", icon: "icons/linux.svg" },
  { key: "bash", name: "Bash", icon: "icons/bash.svg" },
];
---

<section id="skills" class="py-32 bg-[#030712] relative overflow-hidden">
  <!-- Decorative background light -->
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-blue-900/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 sm:px-12 relative z-10">
    
    <!-- Section Header -->
    <div class="mb-16 text-left max-w-3xl">
      <span class="text-xs font-bold tracking-[0.3em] text-blue-400 uppercase mb-3 block">
        <span class="lang-en-text">Expertise</span>
        <span class="lang-es-text">Especialidades</span>
      </span>
      <h2 class="text-white text-4xl sm:text-5xl md:text-6xl font-black leading-tight tracking-tight mb-6">
        <span class="lang-en-text">Our <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-400">tech stack</span>.</span>
        <span class="lang-es-text">Nuestro <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-blue-400">stack tecnológico</span>.</span>
      </h2>
      <p class="text-gray-400 text-lg font-light leading-relaxed">
        <span class="lang-en-text">The core technologies we leverage to design scalable, production-grade applications.</span>
        <span class="lang-es-text">Las tecnologías principales que usamos para diseñar aplicaciones escalables y listas para producción.</span>
      </p>
    </div>

    <!-- Skills Grid -->
    <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 place-items-center">
      {
        skills.map((s) => (
          <li
            class="skill-card group w-full aspect-square flex flex-col items-center justify-center p-6 bg-[#0b1120]/30 border border-white/5 rounded-3xl select-none transition-all duration-300 ease-out hover:border-blue-500/25 hover:shadow-2xl hover:shadow-blue-500/5"
            data-key={s.key}
            aria-label={s.name}
          >
            <div class="icon-wrap w-16 h-16 rounded-2xl flex items-center justify-center bg-white/5 transition-transform duration-300 group-hover:scale-110 group-hover:bg-white/10">
              <img
                src={s.icon}
                alt={s.name}
                class="skill-icon w-10 h-10 filter grayscale opacity-50 transition-all duration-300 group-hover:grayscale-0 group-hover:opacity-100 group-hover:drop-shadow-[0_0_12px_rgba(168,85,247,0.4)]"
              />
            </div>
            <span class="skill-name mt-5 text-xs font-bold tracking-widest text-gray-400 uppercase transition-colors duration-300 group-hover:text-blue-300">
              {s.name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  if (typeof window !== "undefined") {
    function initSkills() {
      const cards = Array.from(document.querySelectorAll(".skill-card"));
      const floatTweens = new Map();

      function createFloat(card, delay = 0) {
        if (floatTweens.has(card)) {
          const prev = floatTweens.get(card);
          try { prev.kill(); } catch (e) {}
        }
        const dur = 4 + Math.random() * 3;
        const y = 5 + Math.random() * 5;
        const tween = gsap.to(card, {
          y: `+=${y}`,
          duration: dur,
          ease: "sine.inOut",
          repeat: -1,
          yoyo: true,
          delay,
        });
        floatTweens.set(card, tween);
        return tween;
      }

      // Create initial float
      cards.forEach((card, i) => createFloat(card, (i % 6) * 0.1));

      // Pointer event tilts
      cards.forEach((card) => {
        const enter = () => {
          const t = floatTweens.get(card);
          if (t) t.pause();

          gsap.to(card, { scale: 1.05, y: -5, duration: 0.25, ease: "power2.out" });
        };

        const leave = () => {
          gsap.to(card, {
            scale: 1,
            rotateX: 0,
            rotateY: 0,
            y: 0,
            duration: 0.4,
            ease: "power3.out",
            onComplete: () => {
              createFloat(card);
            },
          });
        };

        const move = (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width;
          const py = (e.clientY - rect.top) / rect.height;
          const rotY = (px - 0.5) * 15;
          const rotX = (0.5 - py) * 15;
          gsap.to(card, { rotateY: rotY, rotateX: rotX, duration: 0.15, ease: "power1.out" });
        };

        card.addEventListener("pointerenter", enter);
        card.addEventListener("pointerleave", leave);
        card.addEventListener("pointermove", move);
      });
    }

    if (document.readyState === "loading") {
      window.addEventListener("DOMContentLoaded", initSkills);
    } else {
      initSkills();
    }
  }
</script>

